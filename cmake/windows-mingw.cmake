# Windows cross-build for development through Proton on Linux.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(nanova_toolchains "${CMAKE_CURRENT_LIST_DIR}/../build/toolchains" ABSOLUTE)
if(NOT DEFINED CMAKE_CXX_COMPILER)
    if(EXISTS "${nanova_toolchains}/mingw/usr/bin/x86_64-w64-mingw32-g++-posix")
        set(CMAKE_CXX_COMPILER "${nanova_toolchains}/mingw/usr/bin/x86_64-w64-mingw32-g++-posix")
    else()
        set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
    endif()
endif()
if(NOT DEFINED CMAKE_RC_COMPILER)
    if(EXISTS "${nanova_toolchains}/mingw/usr/bin/x86_64-w64-mingw32-windres")
        set(CMAKE_RC_COMPILER "${nanova_toolchains}/mingw/usr/bin/x86_64-w64-mingw32-windres")
    else()
        set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
    endif()
endif()
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
if(NOT DEFINED Vulkan_INCLUDE_DIR AND EXISTS "${nanova_toolchains}/vulkan-include/vulkan/vulkan.h")
    set(Vulkan_INCLUDE_DIR "${nanova_toolchains}/vulkan-include" CACHE PATH "Windows Vulkan headers")
endif()
if(NOT DEFINED Vulkan_LIBRARY AND EXISTS "${nanova_toolchains}/libvulkan-1.a")
    set(Vulkan_LIBRARY "${nanova_toolchains}/libvulkan-1.a" CACHE FILEPATH "Windows Vulkan import library")
endif()

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "microship: configure Windows",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/windows-cross",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/windows-mingw.cmake",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_CROSSCOMPILING_EMULATOR=python3;${workspaceFolder}/scripts/proton_run.py",
                "-DMICROSHIP_GPU_TESTS=OFF"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "hide": true
        },
        {
            "label": "microship: build Windows",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/windows-cross",
                "--config",
                "Release",
                "--target",
                "microship",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "microship: configure Windows",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "microship: run (Proton)",
            "detail": "Play the virus-side biological prototype with ambient lighting.",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/proton_run.py",
                "${workspaceFolder}/build/windows-cross/microship.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "microship: build Windows",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "microship: CPU E2E checks (Proton)",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/check.sh",
                "--cpu"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "microship: gameplay E2E (Proton)",
            "detail": "Incremental build and CPU-only biological gameplay checks for both sides.",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tests/e2e/biology.py",
                "${workspaceFolder}/build/windows-cross/microship.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "microship: build Windows",
            "problemMatcher": []
        },
        {
            "label": "microship: play as virus (Proton)",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/proton_run.py",
                "${workspaceFolder}/build/windows-cross/microship.exe",
                "--world",
                "${workspaceFolder}/assets/levels/biology-virus.world",
                "--config",
                "${workspaceFolder}/assets/rendering/biology.render"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "microship: build Windows",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "microship: play as white blood cells (Proton)",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/proton_run.py",
                "${workspaceFolder}/build/windows-cross/microship.exe",
                "--world",
                "${workspaceFolder}/assets/levels/biology-immune.world",
                "--config",
                "${workspaceFolder}/assets/rendering/biology.render"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "microship: build Windows",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "microship: planetary prototype (Proton)",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/proton_run.py",
                "${workspaceFolder}/build/windows-cross/microship.exe",
                "--world",
                "${workspaceFolder}/assets/levels/prototype.world",
                "--config",
                "${workspaceFolder}/assets/rendering/first.render"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "microship: build Windows",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}

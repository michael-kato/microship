{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "nanovore: configure Windows",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build/windows-cross",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/windows-mingw.cmake",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_CROSSCOMPILING_EMULATOR=python3;${workspaceFolder}/scripts/proton_run.py",
        "-DNANOVORE_GPU_TESTS=OFF"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "nanovore: build Windows",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/windows-cross",
        "--config",
        "Release",
        "--target",
        "nanovore",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "nanovore: configure Windows",
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "nanovore: run (Proton)",
      "detail": "Build and start Nanovore with the normal faction menu.",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/proton_run.py",
        "${workspaceFolder}/build/windows-cross/nanovore.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "nanovore: build Windows",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "nanovore: CPU E2E checks (Proton)",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/check.sh", "--cpu"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "nanovore: gameplay E2E (Proton)",
      "detail": "Build and run CPU application checks for biological gameplay.",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tests/e2e/biology.py",
        "${workspaceFolder}/build/windows-cross/nanovore.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "nanovore: build Windows",
      "problemMatcher": []
    },
    {
      "label": "nanovore: play as virus (Proton)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/proton_run.py",
        "${workspaceFolder}/build/windows-cross/nanovore.exe",
        "--world",
        "${workspaceFolder}/assets/levels/large_level.json",
        "--faction",
        "virus",
        "--config",
        "${workspaceFolder}/assets/rendering/renderer.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "nanovore: build Windows",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "nanovore: play as white blood cells (Proton)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/proton_run.py",
        "${workspaceFolder}/build/windows-cross/nanovore.exe",
        "--world",
        "${workspaceFolder}/assets/levels/large_level.json",
        "--faction",
        "immune",
        "--config",
        "${workspaceFolder}/assets/rendering/renderer.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "nanovore: build Windows",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "nanovore: play as fungus (Proton)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/proton_run.py",
        "${workspaceFolder}/build/windows-cross/nanovore.exe",
        "--world",
        "${workspaceFolder}/assets/levels/large_level.json",
        "--faction",
        "fungus",
        "--config",
        "${workspaceFolder}/assets/rendering/renderer.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "nanovore: build Windows",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "nanovore: format JSON",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/format_json.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "nanovore: check JSON formatting",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/format_json.py", "--check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

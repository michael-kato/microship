#version 460
#extension GL_EXT_ray_query : require

// Each invocation computes a complete pixel from current-render samples only.
// Lambertian / dielectric/conductor GGX; one-sided triangle star area light.
// Atmospheres use exponential density, Rayleigh/Mie phase functions, and
// current-frame single scattering. Transmittance uses midpoint quadrature.
// The finite scattering-depth setting truncates indirect transport. No denoiser,
// radiance clamp, prior-frame samples, shading cache, or upscaling is used.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct Vertex
{
    vec4 position;
    vec4 normal;
    vec4 color;
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene_acceleration;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D output_image;
layout(set = 0, binding = 2, std430) readonly buffer VertexBuffer
{
    Vertex vertices[];
};
layout(set = 0, binding = 3, std430) readonly buffer TriangleBuffer
{
    uvec4 triangles[]; // XYZ vertex indices; W: 0 dielectric, 1 sun, 2 conductor.
};
layout(set = 0, binding = 4, std140) uniform RenderUniform
{
    vec4 camera_position;
    vec4 camera_forward;
    vec4 camera_right;
    vec4 camera_up;
    vec4 background;
    vec4 light;        // W: star radiance multiplier.
    uvec4 settings;   // Width, height, paths per pixel, max scattering events.
    uvec4 scene;      // First light triangle, light triangle count, RNG seed, media count.
    vec4 display;     // Exposure, tan(vertical FOV / 2), aspect, volume integration steps.
} render;

struct Medium
{
    vec4 center_radius;
    vec4 rayleigh_mie;
    vec4 absorption_phase;
    vec4 shape;
};
layout(set = 0, binding = 5, std430) readonly buffer MediaBuffer { Medium media[]; };

Vertex world_vertex(uint index, uint material)
{
    Vertex v = vertices[index];
    if (material == 1u) v.position.xyz += render.light.xyz;
    return v;
}

const float PI = 3.14159265358979323846;
const float RAY_MAX = 3.402823466e38;

float random_float(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint value = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    value = (value >> 22u) ^ value;
    return float(value >> 8u) * (1.0 / 16777216.0);
}

float point_epsilon(vec3 point)
{
    return max(0.0001, 0.00001 * max(max(abs(point.x), abs(point.y)), abs(point.z)));
}

bool closest_hit(vec3 origin, vec3 direction, out uint triangle_index,
                 out vec2 barycentric, out float distance)
{
    distance = RAY_MAX;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene_acceleration, gl_RayFlagsOpaqueEXT,
                          0xffu, origin, 0.0, direction, RAY_MAX);
    while (rayQueryProceedEXT(query))
    {
        // Opaque triangles are committed by traversal without an any-hit shader.
    }
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT)
        return false;

    triangle_index = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true)) +
                     rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
    barycentric = rayQueryGetIntersectionBarycentricsEXT(query, true);
    distance = rayQueryGetIntersectionTEXT(query, true);
    return true;
}

bool sun_occluded(vec3 origin, vec3 direction, float distance)
{
    // Both callers aim at a front-facing point on the convex sun. Its own
    // geometry cannot occlude that segment; skip the sun BLAS (instance mask 2).
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene_acceleration,
                          gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
#ifdef MICROSHIP_REFERENCE_LIGHTING
                          0xffu, origin, 0.0, direction, distance);
#else
                          0x1u, origin, 0.0, direction, distance);
#endif
    while (rayQueryProceedEXT(query))
    {
    }
    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

float power_weight(float sample_pdf, float other_pdf)
{
    // Dividing before squaring avoids overflow for small grazing-light PDFs.
    float scale = max(sample_pdf, other_pdf);
    if (scale <= 0.0)
        return 0.0;
    float sample_value = sample_pdf / scale;
    float other_value = other_pdf / scale;
    return sample_value * sample_value /
           (sample_value * sample_value + other_value * other_value);
}

vec3 cosine_direction(vec3 normal, inout uint state)
{
    float radius = sqrt(random_float(state));
    float angle = 2.0 * PI * random_float(state);
    vec3 axis = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(axis, normal));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * (radius * cos(angle)) + bitangent * (radius * sin(angle)) +
                     normal * sqrt(max(0.0, 1.0 - radius * radius)));
}

bool medium_interval(Medium medium, vec3 origin, vec3 direction, float distance,
                     out float begin, out float end)
{
    vec3 offset = origin - medium.center_radius.xyz;
    float b = dot(offset, direction);
    float c = dot(offset, offset) - medium.center_radius.w * medium.center_radius.w;
    float discriminant = b * b - c;
    if (discriminant <= 0.0) return false;
    float root = sqrt(discriminant);
    begin = max(0.0, -b - root);
    end = min(distance, -b + root);
    return end > begin;
}

float medium_density(Medium medium, vec3 point)
{
    if (medium.shape.z > 0.5) return 1.0;
    float altitude = max(0.0, length(point - medium.center_radius.xyz) - medium.shape.y);
    return exp(-altitude / medium.shape.x);
}

vec3 transmittance(vec3 origin, vec3 direction, float distance)
{
    vec3 optical_depth = vec3(0.0);
    for (uint i = 0u; i < render.scene.w; ++i)
    {
        Medium medium = media[i];
        float begin, end;
        if (!medium_interval(medium, origin, direction, distance, begin, end)) continue;
        float density_integral = end - begin;
        if (medium.shape.z < 0.5)
        {
            uint steps = uint(render.display.w);
            float stride = (end - begin) / float(steps);
            density_integral = 0.0;
            for (uint j = 0u; j < steps; ++j)
                density_integral += stride * medium_density(medium, origin + direction * (begin + (float(j) + 0.5) * stride));
        }
        vec3 extinction = medium.rayleigh_mie.rgb + vec3(medium.rayleigh_mie.w) + medium.absorption_phase.rgb;
        optical_depth += extinction * density_integral;
    }
    return exp(-optical_depth);
}

float henyey_greenstein(float cosine, float g)
{
    float denominator = 1.0 + g*g - 2.0*g*cosine;
    return (1.0 - g*g) / (4.0*PI*denominator*sqrt(denominator));
}

vec3 volume_light(vec3 point, vec3 view_direction, Medium medium, inout uint state)
{
    uint index = render.scene.x + min(uint(random_float(state) * float(render.scene.y)), render.scene.y - 1u);
    uvec4 triangle = triangles[index];
    Vertex a = world_vertex(triangle.x, 1u), b = world_vertex(triangle.y, 1u), c = world_vertex(triangle.z, 1u);
    vec3 area_normal = cross(b.position.xyz - a.position.xyz, c.position.xyz - a.position.xyz);
    float twice_area = length(area_normal);
    vec3 normal = area_normal / twice_area;
    float root = sqrt(random_float(state)), split = random_float(state);
    vec3 weights = vec3(1.0-root, root*(1.0-split), root*split);
    vec3 light_point = a.position.xyz*weights.x + b.position.xyz*weights.y + c.position.xyz*weights.z;
    vec3 delta = light_point - point;
    float distance_squared = dot(delta, delta);
    if (distance_squared <= 0.0) return vec3(0.0);
    vec3 direction = delta * inversesqrt(distance_squared);
    float light_cosine = dot(normal, -direction);
    if (light_cosine <= 0.0) return vec3(0.0);
    vec3 shadow_delta = light_point + normal * point_epsilon(light_point) - point;
    float shadow_distance = length(shadow_delta);
    if (shadow_distance <= 0.0001 || sun_occluded(point, shadow_delta / shadow_distance, shadow_distance - 0.0001))
        return vec3(0.0);
    float light_pdf = distance_squared / (float(render.scene.y) * 0.5 * twice_area * light_cosine);
    float cosine = clamp(dot(view_direction, direction), -1.0, 1.0);
    float rayleigh_phase = 3.0 * (1.0 + cosine*cosine) / (16.0*PI);
    float mie_phase = henyey_greenstein(cosine, medium.absorption_phase.w);
    vec3 phase_scattering = medium.shape.z > 0.5 ? medium.rayleigh_mie.rgb * mie_phase :
        medium.rayleigh_mie.rgb * rayleigh_phase + vec3(medium.rayleigh_mie.w * mie_phase);
    vec3 emission = (a.color.rgb*weights.x + b.color.rgb*weights.y + c.color.rgb*weights.z) * render.light.w;
    return phase_scattering * emission * transmittance(point, direction, sqrt(distance_squared)) / light_pdf;
}

vec3 single_scattering(vec3 origin, vec3 direction, float distance, inout uint state)
{
    vec3 radiance = vec3(0.0);
    for (uint i = 0u; i < render.scene.w; ++i)
    {
        Medium medium = media[i];
        float begin, end;
        if (!medium_interval(medium, origin, direction, distance, begin, end)) continue;
        float sample_distance = mix(begin, end, random_float(state));
        vec3 point = origin + direction * sample_distance;
#ifdef MICROSHIP_REFERENCE_LIGHTING
        // Previous evaluation order, compiled only for full-application E2E comparisons.
        radiance += transmittance(origin, direction, sample_distance) * medium_density(medium, point) *
                    volume_light(point, direction, medium, state) * (end - begin);
#else
        vec3 incident = volume_light(point, direction, medium, state);
        // Rejected/back-facing/occluded light samples contribute exactly zero.
        // Keep RNG consumption and quadrature unchanged, but avoid traversing
        // every medium again for the camera segment when no light arrives.
        if (any(greaterThan(incident, vec3(0.0))))
            radiance += transmittance(origin, direction, sample_distance) * medium_density(medium, point) *
                        incident * (end - begin);
#endif
    }
    return radiance;
}

float fresnel(float cosine, float ior)
{
    float f0 = (ior - 1.0) / (ior + 1.0);
    f0 *= f0;
    return f0 + (1.0 - f0) * pow(1.0 - clamp(cosine, 0.0, 1.0), 5.0);
}

float ggx_distribution(float cosine, float alpha)
{
    float a2 = alpha*alpha;
    float denominator = cosine*cosine*(a2-1.0)+1.0;
    return a2 / (PI*denominator*denominator);
}

float ggx_mask(float cosine, float alpha)
{
    return 2.0*cosine / (cosine + sqrt(alpha*alpha + (1.0-alpha*alpha)*cosine*cosine));
}

vec3 evaluate_bsdf(vec3 normal, vec3 outgoing, vec3 incoming, vec3 albedo,
                   float roughness, float ior, bool metal, out float pdf)
{
    float ni = max(0.0, dot(normal, incoming)), no = max(0.0, dot(normal, outgoing));
    pdf = ni / PI;
    if (ni <= 0.0 || no <= 0.0) return vec3(0.0);
    if (!metal && (roughness >= 0.999 || ior <= 1.0)) return albedo / PI;
    vec3 half_vector = normalize(incoming + outgoing);
    float nh = max(0.0, dot(normal, half_vector)), oh = max(0.000001, dot(outgoing, half_vector));
    float alpha = max(0.002, roughness*roughness);
    float distribution = ggx_distribution(nh, alpha);
    if (metal)
    {
        // Vertex RGB is conductor normal-incidence reflectance (Schlick RGB
        // approximation), not diffuse albedo. No diffuse lobe in metal.
        vec3 f = albedo + (vec3(1.0) - albedo) * pow(1.0 - oh, 5.0);
        pdf = distribution * nh / (4.0 * oh);
        return f * distribution * ggx_mask(ni, alpha) * ggx_mask(no, alpha) / (4.0 * ni * no);
    }
    float f = fresnel(oh, ior);
    pdf = 0.5 * (ni / PI + distribution * nh / (4.0*oh));
    float specular = f * distribution * ggx_mask(ni, alpha) * ggx_mask(no, alpha) / (4.0*ni*no);
    return albedo * ((1.0-f) / PI) + vec3(specular);
}

vec3 sample_bsdf(vec3 normal, vec3 outgoing, float roughness, float ior, bool metal, inout uint state)
{
    if (!metal && (roughness >= 0.999 || ior <= 1.0 || random_float(state) < 0.5))
        return cosine_direction(normal, state);
    float alpha = max(0.002, roughness*roughness);
    float u = random_float(state), angle = 2.0*PI*random_float(state);
    float cosine = sqrt((1.0-u) / (1.0+(alpha*alpha-1.0)*u));
    float sine = sqrt(max(0.0, 1.0-cosine*cosine));
    vec3 axis = abs(normal.z) < 0.999 ? vec3(0,0,1) : vec3(0,1,0);
    vec3 tangent = normalize(cross(axis, normal)), bitangent = cross(normal, tangent);
    vec3 half_vector = tangent*(sine*cos(angle)) + bitangent*(sine*sin(angle)) + normal*cosine;
    return reflect(-outgoing, half_vector);
}

vec3 sample_direct(vec3 point, vec3 normal, vec3 geometric_normal,
                   vec3 albedo, vec3 outgoing, float roughness, float ior, bool metal, inout uint state)
{
    if (render.scene.y == 0u)
        return vec3(0.0);

    uint light_index = render.scene.x + min(uint(random_float(state) * float(render.scene.y)),
                                          render.scene.y - 1u);
    uvec4 triangle = triangles[light_index];
    Vertex a = world_vertex(triangle.x, triangle.w);
    Vertex b = world_vertex(triangle.y, triangle.w);
    Vertex c = world_vertex(triangle.z, triangle.w);
    vec3 area_normal = cross(b.position.xyz - a.position.xyz, c.position.xyz - a.position.xyz);
    float twice_area = length(area_normal);
    if (twice_area <= 0.0)
        return vec3(0.0);
    vec3 light_normal = area_normal / twice_area;

    float root = sqrt(random_float(state));
    float split = random_float(state);
    vec3 weights = vec3(1.0 - root, root * (1.0 - split), root * split);
    vec3 light_point = a.position.xyz * weights.x + b.position.xyz * weights.y +
                       c.position.xyz * weights.z;
    vec3 delta = light_point - point;
    float distance_squared = dot(delta, delta);
    if (distance_squared <= 0.0)
        return vec3(0.0);
    vec3 direction = delta * inversesqrt(distance_squared);
    float receiver_cosine = max(0.0, dot(normal, direction));
    float light_cosine = max(0.0, dot(light_normal, -direction));
    if (receiver_cosine <= 0.0 || light_cosine <= 0.0 || dot(geometric_normal, direction) <= 0.0)
        return vec3(0.0);

    vec3 origin = point + geometric_normal * point_epsilon(point);
    vec3 target = light_point + light_normal * point_epsilon(light_point);
    vec3 shadow_delta = target - origin;
    float shadow_distance = length(shadow_delta);
    if (shadow_distance <= 0.0001 ||
        sun_occluded(origin, shadow_delta / shadow_distance, shadow_distance - 0.0001))
        return vec3(0.0);

    // Uniform triangle selection and uniform point sampling within that triangle.
    // UV-sphere triangles have unequal areas, so 1 / total_light_area is incorrect.
    float light_pdf = distance_squared /
                      (float(render.scene.y) * (0.5 * twice_area) * light_cosine);
    float bsdf_pdf;
    vec3 bsdf = evaluate_bsdf(normal, outgoing, direction, albedo, roughness, ior, metal, bsdf_pdf);
    vec3 emission = (a.color.rgb * weights.x + b.color.rgb * weights.y +
                     c.color.rgb * weights.z) * render.light.w;
    return bsdf * emission * transmittance(point, direction, sqrt(distance_squared)) * (receiver_cosine / light_pdf) *
           power_weight(light_pdf, bsdf_pdf);
}

vec3 trace_path(vec3 origin, vec3 direction, inout uint state)
{
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    vec3 previous_point = origin;
    float previous_pdf = 0.0;

    // Evaluate emission/misses on the segment after the final scattering event.
    for (uint depth = 0u; depth <= render.settings.w; ++depth)
    {
        uint triangle_index;
        vec2 barycentric;
        float distance = RAY_MAX;
        bool hit = closest_hit(origin, direction, triangle_index, barycentric, distance);
        if (depth == 0u) radiance += throughput * single_scattering(origin, direction, distance, state);
        throughput *= transmittance(origin, direction, distance);
        if (!hit)
        {
            // The uniform environment is sampled only by the BSDF, not by NEE.
            radiance += throughput * render.background.rgb;
            break;
        }

        uvec4 triangle = triangles[triangle_index];
        Vertex a = world_vertex(triangle.x, triangle.w);
        Vertex b = world_vertex(triangle.y, triangle.w);
        Vertex c = world_vertex(triangle.z, triangle.w);
        vec3 weights = vec3(1.0 - barycentric.x - barycentric.y, barycentric.x, barycentric.y);
        vec3 point = a.position.xyz * weights.x + b.position.xyz * weights.y +
                     c.position.xyz * weights.z;
        vec3 area_normal = cross(b.position.xyz - a.position.xyz, c.position.xyz - a.position.xyz);
        float twice_area = length(area_normal);
        if (twice_area <= 0.0)
            break;
        vec3 geometric_normal = area_normal / twice_area;
        vec3 color = a.color.rgb * weights.x + b.color.rgb * weights.y + c.color.rgb * weights.z;
        float roughness = dot(vec3(a.color.w,b.color.w,c.color.w), weights);
        float ior = dot(vec3(a.position.w,b.position.w,c.position.w), weights);
        float emission = dot(vec3(a.normal.w,b.normal.w,c.normal.w), weights);
        radiance += throughput * color * emission;

        if (triangle.w == 1u)
        {
            float light_cosine = dot(geometric_normal, -direction);
            if (light_cosine > 0.0)
            {
                float weight = 1.0;
                if (depth > 0u && triangle_index >= render.scene.x &&
                    triangle_index - render.scene.x < render.scene.y)
                {
                    vec3 delta = point - previous_point;
                    float light_pdf = dot(delta, delta) /
                        (float(render.scene.y) * (0.5 * twice_area) * light_cosine);
                    weight = power_weight(previous_pdf, light_pdf);
                }
                radiance += throughput * color * render.light.w * weight;
            }
            break;
        }
        if (depth == render.settings.w)
            break;

        vec3 normal = normalize(a.normal.xyz * weights.x + b.normal.xyz * weights.y +
                                c.normal.xyz * weights.z);
        if (dot(normal, geometric_normal) < 0.0)
            normal = -normal;
        if (dot(geometric_normal, direction) > 0.0)
        {
            geometric_normal = -geometric_normal;
            normal = -normal;
        }
        if (dot(normal, -direction) <= 0.0)
            normal = geometric_normal;

        vec3 outgoing = -direction;
        radiance += throughput * sample_direct(point, normal, geometric_normal, color, outgoing, roughness, ior, triangle.w == 2u, state);
        vec3 next_direction = sample_bsdf(normal, outgoing, roughness, ior, triangle.w == 2u, state);
        // Do not resample directions below the actual triangle surface; they
        // have zero transport. Resampling would require a changed sampling PDF.
        if (dot(geometric_normal, next_direction) <= 0.0)
            break;
        vec3 bsdf = evaluate_bsdf(normal, outgoing, next_direction, color, roughness, ior, triangle.w == 2u, previous_pdf);
        if (previous_pdf <= 0.0) break;
        throughput *= bsdf * max(0.0, dot(normal, next_direction)) / previous_pdf;
        previous_point = point;
        origin = point + geometric_normal * point_epsilon(point);
        direction = next_direction;
    }
    return radiance;
}

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= render.settings.x || pixel.y >= render.settings.y)
        return;

    uint state = (pixel.y * render.settings.x + pixel.x) ^ (render.scene.z * 2891336453u);
    vec3 sum = vec3(0.0);
    for (uint sample_index = 0u; sample_index < render.settings.z; ++sample_index)
    {
        vec2 jitter = vec2(random_float(state), random_float(state));
        vec2 film = (vec2(pixel) + jitter) / vec2(render.settings.xy);
        vec2 ndc = vec2(2.0 * film.x - 1.0, 1.0 - 2.0 * film.y);
        vec3 direction = normalize(render.camera_forward.xyz +
                                   render.camera_right.xyz * (ndc.x * render.display.y * render.display.z) +
                                   render.camera_up.xyz * (ndc.y * render.display.y));
        sum += trace_path(render.camera_position.xyz, direction, state);
    }

    // Keep HDR energy until current-frame bloom and the display transform.
    imageStore(output_image, ivec2(pixel), vec4(sum / float(render.settings.z), 1.0));
}

# First playable scene. Units, sunlight costs, and upgrades are still unimplemented.
# star x y z radius r g b
star 0 -35 -95 5 1 0.85 0.60
# The initial camera's horizontal axis is +X. One orbit takes two minutes.
sun_orbit 0 0 0 1 0 0 120

# Only the player and enemy home planets in this first scene.
# planet owner x y z radius r g b
planet player -7 0 0 3 0.95 1 0.98
planet enemy   7 0 0 3 1 0.92 0.86

# Mesh references are relative to this world file. All bodies remain stationary.
model 0 ../models/temperate.fmesh
model 1 ../models/desert.fmesh

# body height_fraction scale_height_fraction Rayleigh_RGB Mie absorption anisotropy
atmosphere 0 0.13 0.035 0.08 0.20 0.48 0.025 0.005 0.76
atmosphere 1 0.12 0.040 0.22 0.11 0.04 0.060 0.010 0.72

# Battlefield dust makes physically shadowed sunlight shafts visible.
haze 0 0 0 22 0.003 0.0035 0.004 0.78
# Faint scene-wide scattering, including the camera and the entire sun orbit.
global_atmosphere 0 0 0 180 0.00015 0.00019 0.00026 0.65
# Static visual placements; automatic production and ship movement come later.
ship flowery large ../models/flowery_large.fmesh -7 1 4.7 1.2 20 1 1 1
ship flowery small ../models/flowery_small.fmesh -4.8 0.8 4.2 0.55 10 1 1 1
ship crystalline large ../models/crystalline_large.fmesh 7 1 4.7 1.2 -20 1 1 1
ship crystalline small ../models/crystalline_small.fmesh 4.8 0.8 4.2 0.55 -10 1 1 1

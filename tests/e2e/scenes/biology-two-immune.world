# Biological gameplay prototype. No star, sun orbit or planet atmospheres.
biology immune
ambient .07 .055 .065
ambient_gradient 1 1 1 .5 .5 .6
# Cell membranes, organelles and extracellular tissue use vertex colors only.
cell virus -6 0 0 3.2 1 1 1
cell immune 6 0 0 3.2 1 1 1
model 0 ../../../assets/models/cell_infected.fmesh
model 1 ../../../assets/models/cell_healthy.fmesh
nutrients 0 1
nutrients 1 1
colony_site 0 0 .45 .893
colony_site 1 0 .45 .893
backdrop ../../../assets/models/soft_bloodstream_background.fmesh 0 2 -14 32 1 1 1
# Decorative native-resolution layer: blur radius, glow, ambient, pulse amplitude, period.
backdrop_soft 6 .25 .65 .008 7
backdrop_wave .012 9 .55
# Prototype combat and nutrient economy; all values editable without rebuilding C++.
fighter_rules 3.5 36 8 3.2 12
seedship_rules 1.8 60 30
stalk_rules 5 80 5 1.4 1.6
economy_rules 100 2.5 1.5 90
stalk_model ../../../assets/models/cell_replication_node.fmesh
# Large units establish nodes. Small units clear defenders.
ship virus large ../../../assets/models/virus_infector.fmesh -6 2.8 5.2 .9 0 1 1 1
ship immune large ../../../assets/models/immune_macrophage.fmesh 6 2.8 5.2 .9 0 1 1 1
ship virus small ../../../assets/models/virus_virion.fmesh -6.85 1.6 5.2 .15 0 1 1 1
ship virus small ../../../assets/models/virus_virion.fmesh -6.0 1.6 5.2 .15 0 1 1 1
ship virus small ../../../assets/models/virus_virion.fmesh -5.15 1.6 5.2 .15 0 1 1 1
ship immune small ../../../assets/models/immune_leukocyte.fmesh 5.15 1.6 5.2 .15 0 1 1 1
ship immune small ../../../assets/models/immune_leukocyte.fmesh 6.0 1.6 5.2 .15 0 1 1 1
ship immune small ../../../assets/models/immune_leukocyte.fmesh 6.85 1.6 5.2 .15 0 1 1 1
ship immune small ../../../assets/models/immune_leukocyte.fmesh 5.15 2.3 5.2 .15 0 1 1 1
ship immune small ../../../assets/models/immune_leukocyte.fmesh 6.0 2.3 5.2 .15 0 1 1 1
ship immune small ../../../assets/models/immune_leukocyte.fmesh 6.85 2.3 5.2 .15 0 1 1 1
# Key upper-left/front, softer cool fill, pink rear rim. Directions point toward lights.
studio_light key -.55 .7 .6 1 .76 .68 4
studio_light fill .65 .2 .75 .68 .8 1 1.3
studio_light rim .4 .45 -.8 1 .38 .5 3.5
cell_translucency .38 .12
combat_visuals 12 .6 .035 .42 .12 .32 .35 .48
orbit_rules .6 .48
# Acceleration, heading response, separation distance, maximum banking angle.
flight_rules 9 7 .55 .55
combat_color virus .45 .9 .75
combat_color immune 1 .55 .65
damage_colors 1 .94 .78 1 .035 .055

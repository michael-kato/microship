# Native-resolution fidelity baseline. Every logical render uses only its own samples.
# All fields are required once. These values may be edited without rebuilding C++.
width 1920
height 1080
samples_per_pixel 256
max_bounces 4
seed 1

# Sphere longitude subdivisions and pole-to-pole latitude subdivisions.
sphere_segments 64
sphere_rings 32

camera_position 0 14 38
camera_target 0 0 0
camera_up 0 1 0
vertical_fov_degrees 45
camera_min_distance 8
camera_max_distance 160
volume_steps 8
# Atmospherics are temporarily disabled; surface fidelity stays unchanged.
volume_samples_per_pixel 0
volume_local_bounds 1
microfacet_energy_compensation 1

# Linear radiance, linear background RGB, and display exposure.
sun_radiance 150
background 0.001 0.002 0.004
exposure 1
bloom_radius 32
bloom_strength 0.18
bloom_threshold 1

# Current-frame SPMIS sun reuse experiment; measure before enabling by default.
spatial_sun_reuse 0

# Raw high-sample reference; one independent logical render.
spatial_denoise 0

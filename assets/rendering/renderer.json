{
  "$schema": "../schemas/render.schema.json",
  "output": {
    "width": 1920,
    "height": 1080,
    "exposure": 1.6
  },
  "sampling": {
    "samples_per_pixel": 1,
    "seed": 1,
    "max_transmission_layers": 8,
    "spatial_antialiasing": true
  },
  "geometry": {
    "sphere_segments": 64,
    "sphere_rings": 32
  },
  "camera": {
    "position": [0.0, 0.0, 20.88],
    "target": [0.0, 0.0, 0.0],
    "up": [0.0, 1.0, 0.0],
    "min_distance": 8.0,
    "max_distance": 600,
    "vertical_fov_degrees": 45.0,
    "keyboard_pan_speed": 24
  },
  "lighting": {
    "microfacet_energy_compensation": true,
    "shadow_grid_resolution": 16,
    "static_lighting_cache": true,
    "texture_grid": true,
    "subgroup_size": 32
  },
  "radiance_cascades": {
    "probe_resolution": 16,
    "direction_resolution": 4,
    "cascade_count": 4,
    "first_interval": 1,
    "interval_growth": 4,
    "bounce_feedback": true,
    "cells_per_frame": 4
  },
  "bloom": {
    "radius": 8,
    "strength": 0.14,
    "threshold": 0.55
  },
  "volume": {
    "rays_per_pixel": 1,
    "integration_steps": 3,
    "optical_depth_lut": true,
    "lighting_grid": true,
    "quadrature": "gauss_legendre",
    "spatial_filter": true,
    "spatial_stride": 4
  },
  "depth_of_field": {
    "focus_range": 0.02,
    "blur_scale": 60,
    "max_radius": 24
  },
  "subsurface": {
    "strength": 1,
    "wrap": 0.5,
    "transmission": 0.35,
    "membrane_thickness": 0.16,
    "samples_per_pixel": 1
  },
  "wireframe": {
    "line": [0.45, 1.0, 0.75],
    "fill": [0.004, 0.006, 0.008],
    "line_pixels": 0.5
  },
  "level_of_detail": {
    "surface_minimum_pixels": 2,
    "surface_full_pixels": 8,
    "cell_minimum_pixels": 40,
    "cell_full_pixels": 90,
    "animation_margin": 12,
    "subsurface_minimum_pixels": 4,
    "subsurface_full_pixels": 16
  }
}

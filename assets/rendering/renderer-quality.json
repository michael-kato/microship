{
  "$schema": "../schemas/render.schema.json",
  "output": {
    "width": 1920,
    "height": 1080,
    "exposure": 1.6
  },
  "sampling": {
    "samples_per_pixel": 6,
    "seed": 1,
    "max_transmission_layers": 8
  },
  "geometry": {
    "sphere_segments": 64,
    "sphere_rings": 32
  },
  "camera": {
    "position": [0.0, 0.0, 20.88],
    "target": [0.0, 0.0, 0.0],
    "up": [0.0, 1.0, 0.0],
    "min_distance": 8.0,
    "max_distance": 180,
    "vertical_fov_degrees": 45.0,
    "keyboard_pan_speed": 24
  },
  "lighting": {
    "microfacet_energy_compensation": true,
    "shadow_grid_resolution": 32,
    "static_lighting_cache": true,
    "texture_grid": true,
    "subgroup_size": 32
  },
  "bloom": {
    "radius": 32,
    "strength": 0.0,
    "threshold": 1.0
  },
  "volume": {
    "rays_per_pixel": 1,
    "integration_steps": 8,
    "optical_depth_lut": true,
    "lighting_grid": true
  },
  "depth_of_field": {
    "focus_range": 0.02,
    "blur_scale": 60,
    "max_radius": 24
  },
  "subsurface": {
    "strength": 1,
    "wrap": 0.5,
    "transmission": 0.35,
    "membrane_thickness": 0.06,
    "samples_per_pixel": 1
  }
}

#version 460
#extension GL_GOOGLE_include_directive : require
#include "render_bindings.glsl"
#include "render_uniform.glsl"
layout(local_size_x=COMPUTE_GROUP_SIZE,local_size_y=COMPUTE_GROUP_SIZE) in;
layout(set=0,binding=BLOOM_BINDING_BEAUTY,rgba16f) uniform image2D beauty;
layout(set=0,binding=BLOOM_BINDING_HORIZONTAL,rgba16f) uniform image2D scratch;
layout(set=0,binding=BLOOM_BINDING_SIGHT,std430) readonly buffer Sight { float reveal[FOG_FIELD_SIZE*FOG_FIELD_SIZE];vec4 spheres[]; };
layout(push_constant) uniform Filter
{
    ivec2 extent;int radius;int pass;
    float threshold;float strength;float exposure;float debug_views;
} fog_pass;

float fog_amount(ivec2 pixel)
{
    vec2 uv=(vec2(pixel)+.5)/vec2(fog_pass.extent);
    vec3 direction=render.camera_forward.xyz+render.camera_right.xyz*((2*uv.x-1)*render.display.y*render.display.z)
        +render.camera_up.xyz*((1-2*uv.y)*render.display.y);
    if (abs(direction.z)<.000001) return 1;
    float distance=(render.fog.z-render.camera_position.z)/direction.z;
    if (distance<=0) return 1;
    vec3 point=render.camera_position.xyz+distance*direction;
    vec2 cell=(point.xy-render.fog_grid.xy)/render.fog_grid.z;float visibility=0.0;
    if (all(greaterThanEqual(cell,vec2(0))) && all(lessThanEqual(cell,vec2(FOG_FIELD_SIZE-1))))
    {
        ivec2 lower=min(ivec2(cell),ivec2(FOG_FIELD_SIZE-2));vec2 f=cell-vec2(lower);int index=lower.y*FOG_FIELD_SIZE+lower.x;
        visibility=mix(mix(reveal[index],reveal[index+1],f.x),mix(reveal[index+FOG_FIELD_SIZE],reveal[index+FOG_FIELD_SIZE+1],f.x),f.y);
    }
    // Extreme authored map spans can make this fixed field too coarse. Preserve
    // current sight analytically in that case; normal maps use four field reads.
    if (render.fog_grid.z>render.fog.y*.25)
        for (uint i=0;i<render.scene.z;++i)
            visibility=max(visibility,1.0-smoothstep(-render.fog.y,render.fog.y,length(point-spheres[i].xyz)-spheres[i].w));
    return 1.0-visibility;
}

// Quarter-resolution fog: box downsample, two separable Gaussian passes, then
// native composition where current sight hides the map. Scratch holds two
// disjoint quarter-size tiles; all inputs belong to this frame.
const int FOG_HALF_TAPS = 24;
vec3 blurred_fog(ivec2 pixel,ivec2 small)
{
    vec2 p=(vec2(pixel)+.5)/float(FOG_DOWNSAMPLE)-.5;
    ivec2 low=ivec2(floor(p));vec2 f=fract(p);ivec2 last=small-1;
    vec3 a=imageLoad(scratch,clamp(low,ivec2(0),last)).rgb;
    vec3 b=imageLoad(scratch,clamp(low+ivec2(1,0),ivec2(0),last)).rgb;
    vec3 c=imageLoad(scratch,clamp(low+ivec2(0,1),ivec2(0),last)).rgb;
    vec3 d=imageLoad(scratch,clamp(low+ivec2(1,1),ivec2(0),last)).rgb;
    return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);
}

void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec2 small=(fog_pass.extent+FOG_DOWNSAMPLE-1)/FOG_DOWNSAMPLE;
    if (fog_pass.pass==FOG_COMPOSITE_PASS)
    {
        if (any(greaterThanEqual(pixel,fog_pass.extent))) return;
        float amount=fog_amount(pixel);
        if (amount==0.0) return;
        imageStore(beauty,pixel,vec4(mix(imageLoad(beauty,pixel).rgb,blurred_fog(pixel,small)*render.fog_tint.rgb,amount),1));
        return;
    }
    if (any(greaterThanEqual(pixel,small))) return;
    if (fog_pass.pass==0)
    {
        vec3 sum=vec3(0);float count=0;
        for (int y=0;y<FOG_DOWNSAMPLE;++y) for (int x=0;x<FOG_DOWNSAMPLE;++x)
        {
            ivec2 p=pixel*FOG_DOWNSAMPLE+ivec2(x,y);
            if (any(greaterThanEqual(p,fog_pass.extent))) continue;
            sum+=imageLoad(beauty,p).rgb;count+=1;
        }
        imageStore(scratch,pixel,vec4(sum/count,1));
        return;
    }
    // Sigma is a third of the radius. Taps step one quarter pixel apart until
    // the radius needs wider spacing; no tap repeats a texel.
    float radius=render.fog.x/float(FOG_DOWNSAMPLE),sigma=max(.5,radius/3.0),spacing=max(1.0,radius/float(FOG_HALF_TAPS));
    bool horizontal=fog_pass.pass==1;
    vec3 sum=vec3(0);float weights=0;
    for (int tap=-FOG_HALF_TAPS;tap<=FOG_HALF_TAPS;++tap)
    {
        float x=float(tap)*spacing;if (abs(x)>radius+.5) continue;
        float weight=exp(-.5*x*x/(sigma*sigma));
        ivec2 p=clamp(pixel+(horizontal ? ivec2(int(round(x)),0) : ivec2(0,int(round(x)))),ivec2(0),small-1);
        if (!horizontal) p.y+=small.y;
        sum+=imageLoad(scratch,p).rgb*weight;weights+=weight;
    }
    imageStore(scratch,pixel+(horizontal ? ivec2(0,small.y) : ivec2(0)),vec4(sum/weights,1));
}

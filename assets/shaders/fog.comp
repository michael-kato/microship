#version 460
#extension GL_GOOGLE_include_directive : require
#include "render_bindings.glsl"
#include "render_uniform.glsl"
layout(local_size_x=COMPUTE_GROUP_SIZE,local_size_y=COMPUTE_GROUP_SIZE) in;
layout(set=0,binding=BLOOM_BINDING_BEAUTY,rgba16f) uniform image2D beauty;
layout(set=0,binding=BLOOM_BINDING_HORIZONTAL,rgba16f) uniform image2D scratch;
layout(set=0,binding=BLOOM_BINDING_SIGHT,std430) readonly buffer Sight { float reveal[FOG_FIELD_SIZE*FOG_FIELD_SIZE];vec4 spheres[]; };
layout(push_constant) uniform Filter
{
    ivec2 extent;int radius;int pass;
    float threshold;float strength;float exposure;float debug_views;
} fog_pass;

float fog_amount(ivec2 pixel)
{
    vec2 uv=(vec2(pixel)+.5)/vec2(fog_pass.extent);
    vec3 direction=render.camera_forward.xyz+render.camera_right.xyz*((2*uv.x-1)*render.display.y*render.display.z)
        +render.camera_up.xyz*((1-2*uv.y)*render.display.y);
    if (abs(direction.z)<.000001) return 1;
    float distance=(render.fog.z-render.camera_position.z)/direction.z;
    if (distance<=0) return 1;
    vec3 point=render.camera_position.xyz+distance*direction;
    vec2 cell=(point.xy-render.fog_grid.xy)/render.fog_grid.z;float visibility=0.0;
    if (all(greaterThanEqual(cell,vec2(0))) && all(lessThanEqual(cell,vec2(FOG_FIELD_SIZE-1))))
    {
        ivec2 lower=min(ivec2(cell),ivec2(FOG_FIELD_SIZE-2));vec2 f=cell-vec2(lower);int index=lower.y*FOG_FIELD_SIZE+lower.x;
        visibility=mix(mix(reveal[index],reveal[index+1],f.x),mix(reveal[index+FOG_FIELD_SIZE],reveal[index+FOG_FIELD_SIZE+1],f.x),f.y);
    }
    // Extreme authored map spans can make this fixed field too coarse. Preserve
    // current sight analytically in that case; normal maps use four field reads.
    if (render.fog_grid.z>render.fog.y*.25)
        for (uint i=0;i<render.scene.z;++i)
            visibility=max(visibility,1.0-smoothstep(-render.fog.y,render.fog.y,length(point-spheres[i].xyz)-spheres[i].w));
    return 1.0-visibility;
}

void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel,fog_pass.extent))) return;
    float amount=fog_pass.pass==1 ? fog_amount(pixel) : 1.0;
    if (amount==0.0) return;
    // Two full-resolution 49-tap passes. Scratch is overwritten in this logical frame.
    vec3 sum=vec3(0);float weights=0;
    for (int tap=-24;tap<=24;++tap)
    {
        int offset=int(round(float(tap)*render.fog.x/24));
        float weight=exp(-.5*float(tap*tap)/64);
        ivec2 sample_pixel=clamp(pixel+(fog_pass.pass==0 ? ivec2(offset,0) : ivec2(0,offset)),ivec2(0),fog_pass.extent-1);
        sum+=(fog_pass.pass==0 ? imageLoad(beauty,sample_pixel).rgb : imageLoad(scratch,sample_pixel).rgb)*weight;weights+=weight;
    }
    sum/=weights;
    if (fog_pass.pass==0) imageStore(scratch,pixel,vec4(sum,1));
    else imageStore(beauty,pixel,vec4(mix(imageLoad(beauty,pixel).rgb,sum*render.fog_tint.rgb,amount),1));
}

#version 460
#extension GL_GOOGLE_include_directive : require
#include "debug_buffers.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=1,rgba8) uniform image2D display_image;
layout(push_constant) uniform Debug {
    uvec4 header; // Width, height, buffer views, stats.
    vec4 settings; // Exposure, surface spp, depth scale, unused.
    ivec4 marker;
    vec4 status,accent,feedback;
    ivec4 hover;
} debug;

// Procedural 4x7 glyphs: no font texture or atlas.
layout(set=0,binding=4,std140) uniform DebugText {
    uvec4 glyphs[32];
    uvec4 mask[1570]; // Native 512x92 debug text plus 960x160 gameplay text, packed in bits.
} text_data;

uint glyph(uint character)
{
    return character<128u ? text_data.glyphs[character/4u][character%4u] : 0u;
}

const uint panel_text[72]=uint[72](
    0x55414542u,0x00005954u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,
    0x454e494cu,0x48205241u,0x00005244u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,
    0x45524944u,0x2f205443u,0x4d414320u,0x00415245u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,
    0x49444e49u,0x54434552u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,
    0x54524556u,0x52205845u,0x2d204247u,0x4d415320u,0x20454c50u,0x00000030u,0x00000000u,0x00000000u,
    0x4d524f4eu,0x20534c41u,0x4153202du,0x454c504du,0x00003020u,0x00000000u,0x00000000u,0x00000000u,
    0x54504544u,0x202d2048u,0x504d4153u,0x3020454cu,0x00000000u,0x00000000u,0x00000000u,0x00000000u,
    0x554c4f56u,0x0000454du,0x00000000u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,0x00000000u,
    0x52455551u,0x20534549u,0x4c432052u,0x5345534fu,0x20472054u,0x44414853u,0x0000574fu,0x00000000u
);


bool ink(uint character, ivec2 cell)
{
    if (cell.x<0 || cell.y<0 || cell.x>=4 || cell.y>=7) return false;
    return (glyph(character) & (1u << uint(cell.y*4+cell.x)))!=0u;
}

vec3 srgb(vec3 linear)
{
    return mix(1.055*pow(linear,vec3(1.0/2.4))-0.055,
               12.92*linear,lessThanEqual(linear,vec3(0.0031308)));
}

vec3 radiance_display(vec3 value)
{
    vec3 linear=max(value,vec3(0))*debug.settings.x;
    return srgb(linear/(vec3(1)+linear));
}

vec3 buffer_value(uint panel, DebugPixel data)
{
    if (panel==0u) return unpackUnorm4x8(floatBitsToUint(data.direct.w)).rgb;
    if (panel==1u) return radiance_display(data.surface.rgb+data.volume.rgb);
    if (panel==2u) return radiance_display(data.direct.rgb);
    if (panel==3u) return radiance_display(max(data.surface.rgb-data.direct.rgb,vec3(0)));
    if (panel==4u) return (data.vertex_hit.w==1.0 || data.vertex_hit.w==3.0) ? srgb(clamp(data.vertex_hit.rgb,0.0,1.0)) : vec3(0);
    if (panel==5u) return (data.vertex_hit.w==1.0 || data.vertex_hit.w==3.0) ? 0.5+0.5*data.normal_depth.xyz : vec3(0);
    if (panel==6u) return data.vertex_hit.w>0.0 ? vec3(1.0/(1.0+data.normal_depth.w/debug.settings.z)) : vec3(0);
    if (panel==7u) return radiance_display(data.volume.rgb);
    return clamp(vec3(data.surface.w,data.volume.w,0.0)/(max(debug.settings.y,1.0)*4.0),0.0,1.0);
}

void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy), extent=ivec2(debug.header.xy);
    if (any(greaterThanEqual(pixel,extent))) return;
    bool views=debug.header.z!=0u, stats=debug.header.w!=0u;
    int top=stats ? 92 : 0;
    vec3 value;
    if (views)
    {
        value=vec3(0.012,0.016,0.022);
        if (pixel.y>=top && extent.y>top+96 && extent.x>=96)
        {
            ivec2 cell=min(ivec2(2),ivec2(pixel.x*3/extent.x,(pixel.y-top)*3/(extent.y-top)));
            ivec2 start=ivec2(cell.x*extent.x/3,top+cell.y*(extent.y-top)/3);
            ivec2 end=ivec2((cell.x+1)*extent.x/3,top+(cell.y+1)*(extent.y-top)/3);
            uint panel=uint(cell.y*3+cell.x);
            ivec2 local=pixel-start;
            if (local.x==0 || local.y==0) value=vec3(0.2,0.24,0.28);
            if (local.y>=6 && local.y<20 && local.x>=8)
            {
                int index=(local.x-8)/10;
                if (index<32)
                {
                    uint character=(panel_text[panel*8u+uint(index)/4u] >> (8u*(uint(index)%4u))) & 255u;
                    if (ink(character,ivec2(((local.x-8)%10)/2,(local.y-6)/2))) value=vec3(0.8,0.88,0.96);
                }
            }
            vec2 available=vec2(end-start)-vec2(12,34);
            float scale=min(available.x/float(extent.x),available.y/float(extent.y));
            ivec2 size=ivec2(floor(vec2(extent)*scale));
            ivec2 offset=ivec2((end.x-start.x-size.x)/2,28+(int(available.y)-size.y)/2);
            ivec2 location=local-offset;
            if (all(greaterThanEqual(location,ivec2(0))) && all(lessThan(location,size)))
            {
                ivec2 source=clamp(ivec2(vec2(location)/scale),ivec2(0),extent-1);
                value=buffer_value(panel,debug_pixels[source.y*extent.x+source.x]);
            }
        }
    }
    else value=imageLoad(display_image,pixel).rgb;
    vec3 accent=debug.accent.rgb;
    vec3 selected=debug.accent.w<0.0 ? vec3(1.0,.42,.48) : accent;
    if (!views && debug.settings.w>0.0)
    {
        vec2 d=vec2(pixel-debug.marker.xy);
        float radial=length(d),angle=atan(d.y,d.x);
        if (debug.marker.w!=0)
        {
            float line=1.0-smoothstep(.6,1.6,abs(radial-float(debug.marker.z)));
            float dash=smoothstep(.15,.35,abs(sin(angle*6.0)));
            value=mix(value,selected,line*dash*.75);
            float age=debug.feedback.x;
            if (age>=0.0 && age<1.0)
            {
                float ring=float(debug.marker.z)+age*35.0;
                float pulse=(1.0-age)*(1.0-smoothstep(.5,2.5,abs(radial-ring)));
                value=mix(value,accent,pulse*.85);
            }
        }
        if (debug.hover.w!=0)
        {
            float line=1.0-smoothstep(.4,1.5,abs(length(vec2(pixel-debug.hover.xy))-float(debug.hover.z)));
            value=mix(value,vec3(.94,.86,.78),line*.45);
        }
    }
    if (stats && pixel.x<512 && pixel.y<92)
    {
        value=views ? vec3(0.012,0.016,0.022) : value*0.18;
        uint bit=uint(pixel.y*512+pixel.x), word=bit/32u;
        if ((text_data.mask[word/4u][word%4u] & (1u << (bit%32u)))!=0u)
            value=vec3(0.92,0.97,0.87);
    }
    if (!views && debug.settings.w>0.0)
    {
        // Two compact tactical cards. Text is a CPU-generated bit mask, never a texture.
        bool left=pixel.x>=24 && pixel.x<604 && pixel.y>=extent.y-144 && pixel.y<extent.y-24;
        bool right=pixel.x>=extent.x-464 && pixel.x<extent.x-24 && pixel.y>=extent.y-164 && pixel.y<extent.y-24;
        if (left || right)
        {
            ivec2 local=pixel-ivec2(left ? 24 : extent.x-464,left ? extent.y-144 : extent.y-164);
            int width=left ? 580 : 440;
            vec2 q=abs(vec2(local)-vec2(width*.5,left ? 60 : 70))-vec2(width*.5-9,left ? 51 : 61);
            float edge=length(max(q,vec2(0)))+min(max(q.x,q.y),0.0)-8.0;
            if (edge<0.0)
            {
                vec3 base=vec3(.028,.025,.044);
                value=mix(value,base,.90);
                if (edge> -1.0) value=mix(value,accent,.28);
                if (local.x<3) value=accent*.8;
                int row=(local.y-12)/24;
                int line=row+(left ? 0 : 4);
                ivec2 letter=ivec2(local.x-14,(local.y-12)%24);
                if (local.y>=12 && row<4 && letter.x>=0 && letter.y<14 && letter.x<width-28)
                {
                    uint bit=uint(512*92+(8+line*18+letter.y)*960+8+letter.x),word=bit/32u;
                    if ((text_data.mask[word/4u][word%4u] & (1u << (bit%32u)))!=0u)
                        value=row==0 ? accent : row==2 && left ? vec3(1.0,.88,.7) : vec3(.83,.85,.87);
                }
                if (!left && local.y>=114 && local.y<128)
                {
                    int bar=local.y<120 ? 0 : 1;
                    float progress=bar==0 ? debug.status.z : debug.status.w;
                    value=vec3(.1,.10,.13);
                    if (local.x>=14 && local.x<426 && float(local.x-14)/412.0<progress)
                        value=bar==0 ? accent*.7 : vec3(.96,.69,.42);
                }
                if (!left && debug.status.x>=0.0 && local.y>=33 && local.y<35 && local.x>=14 && local.x<426)
                { value=selected*.16;if (float(local.x-14)/412.0<debug.status.x) value=selected*.75; }
            }
        }
        // Current scene vignette, outside the HUD. No image history or blur.
        else
        {
            vec2 uv=(vec2(pixel)+.5)/vec2(extent);
            value*=1.0-.18*pow(clamp(length((uv-.5)*1.4),0.0,1.0),2.0);
        }
    }
    imageStore(display_image,pixel,vec4(value,1.0));
}

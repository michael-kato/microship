#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#include "render_bindings.glsl"
#include "render_uniform.glsl"

const int BLUR_HALF_TAPS = 24;
const float BLUR_HALF_TAPS_FLOAT = 24.0;
const float BLUR_GAUSSIAN_FALLOFF = 4.5;
const float WAVE_CROSS_AXIS_SCALE = .7;
const float ENVIRONMENT_FILL_SCALE = 0.025;
const uint BACKDROP_RAY_MASK = 4u;
const float RAY_MAX = 3.402823466e38;
const float SILHOUETTE_FADE_COSINE = 0.45;
const float PULSE_SPATIAL_FREQUENCY = 4.0;
const float PRIMARY_PULSE_EXPONENT = 18.0;
const float SECONDARY_PULSE_WEIGHT = .35;
const float SECONDARY_PULSE_PHASE = .8;
const float STUDIO_AMBIENT_WEIGHT = .10;
const float VEIN_BASE_GLOW = .2;
const float VEIN_PULSE_GLOW = 3.5;
const float FACING_GLOW_WEIGHT = 0.55;
const float SECONDARY_PULSE_EXPONENT = 24.0;

// Decorative background only: one center-ray visibility query, vertex color,
// ambient/emission and unshadowed wet studio reflections, then spatial blur.
// This layer never supplies indirect illumination or gameplay collision.
layout(local_size_x=COMPUTE_GROUP_SIZE,local_size_y=COMPUTE_GROUP_SIZE) in;
layout(set=0,binding = RENDER_BINDING_ACCELERATION) uniform accelerationStructureEXT scene_acceleration;
struct Vertex { vec4 position,normal,color,subsurface; };
layout(set=0,binding = RENDER_BINDING_VERTICES,std430) readonly buffer Vertices { Vertex vertices[]; };
layout(set=0,binding = RENDER_BINDING_TRIANGLES,std430) readonly buffer Triangles { uvec4 triangles[]; };
layout(set=0,binding = RENDER_BINDING_BACKGROUND_A,rgba16f) uniform writeonly image2D background_a;
layout(set=0,binding = RENDER_BINDING_BACKGROUND_B,rgba16f) uniform writeonly image2D background_b;
layout(set=0,binding = RENDER_BINDING_SOURCE_A) uniform sampler2D source_a;
layout(set=0,binding = RENDER_BINDING_SOURCE_B) uniform sampler2D source_b;
layout(push_constant) uniform BackgroundPass { int pass; int unused0; int unused1; int unused2; } filter_pass;

void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),extent=ivec2(render.settings.xy);
    if (any(greaterThanEqual(pixel,extent))) return;
    vec2 uv=(vec2(pixel)+0.5)/vec2(extent);
    if (filter_pass.pass>0)
    {
        // Broad, intentionally soft artistic filter. Linear sampling smooths
        // the 49-tap Gaussian; no geometry guides or lighting paths.
        vec2 axis=filter_pass.pass==1 ? vec2(1.0/extent.x,0) : vec2(0,1.0/extent.y);
        vec3 sum=vec3(0);float weights=0;
        for (int i=-BLUR_HALF_TAPS;i<=BLUR_HALF_TAPS;++i)
        {
            float x=float(i)/BLUR_HALF_TAPS_FLOAT,weight=exp(-BLUR_GAUSSIAN_FALLOFF*x*x);
            vec2 position=uv+axis*(x*render.backdrop_style.x);
            sum+=weight*(filter_pass.pass==1 ? textureLod(source_a,position,0).rgb : textureLod(source_b,position,0).rgb);
            weights+=weight;
        }
        // Preserve the center-ray distance, without blurring it across silhouettes.
        float distance=filter_pass.pass==1 ? texelFetch(source_a,pixel,0).a : texelFetch(source_b,pixel,0).a;
        if (filter_pass.pass==1) imageStore(background_b,pixel,vec4(sum/weights,distance));
        else imageStore(background_a,pixel,vec4(sum/weights,distance));
        return;
    }
    vec2 film=uv*2.0-1.0;film.y=-film.y;
    float time=render.backdrop_wave.w;
    film+=render.backdrop_wave.x*vec2(sin(render.backdrop_wave.y*uv.y+time*render.backdrop_wave.z),
        WAVE_CROSS_AXIS_SCALE*sin(render.backdrop_wave.y*uv.x+time*render.backdrop_wave.z*WAVE_CROSS_AXIS_SCALE));
    vec3 direction=normalize(render.camera_forward.xyz+film.x*render.display.y*render.display.z*render.camera_right.xyz
        +film.y*render.display.y*render.camera_up.xyz);
    vec3 environment=render.background.rgb*mix(render.ambient_bottom.rgb,render.ambient_top.rgb,0.5+0.5*direction.y);
    vec3 color=environment*ENVIRONMENT_FILL_SCALE*render.backdrop_style.z;
    float distance=128.0; // Log2(1 + hit distance); 128 marks a miss in RGBA16F.
    rayQueryEXT query;
    rayQueryInitializeEXT(query,scene_acceleration,gl_RayFlagsOpaqueEXT,BACKDROP_RAY_MASK,render.camera_position.xyz,0.0,direction,RAY_MAX);
    while (rayQueryProceedEXT(query)) {}
    if (rayQueryGetIntersectionTypeEXT(query,true)!=gl_RayQueryCommittedIntersectionNoneEXT)
    {
        distance=log2(1.0+rayQueryGetIntersectionTEXT(query,true));
        uint index=rayQueryGetIntersectionPrimitiveIndexEXT(query,true)+rayQueryGetIntersectionInstanceCustomIndexEXT(query,true);
        uvec3 triangle=triangles[index].xyz;
        Vertex a=vertices[triangle.x],b=vertices[triangle.y],c=vertices[triangle.z];
        vec2 bary=rayQueryGetIntersectionBarycentricsEXT(query,true);
        vec3 w=vec3(1.0-bary.x-bary.y,bary);
        vec3 pigment=a.color.rgb*w.x+b.color.rgb*w.y+c.color.rgb*w.z;
        mat3 normal_to_world=transpose(mat3(rayQueryGetIntersectionWorldToObjectEXT(query,true)));
        vec3 normal=normalize(normal_to_world*(a.normal.xyz*w.x+b.normal.xyz*w.y+c.normal.xyz*w.z));
        if (dot(normal,-direction)<0.0) normal=-normal;
        float facing=abs(dot(normal,-direction));
        // A soft edge rolloff suppresses sparse-filter silhouette ringing.
        float shape=smoothstep(0.0,SILHOUETTE_FADE_COSINE,facing);
        float vein=a.normal.w*w.x+b.normal.w*w.y+c.normal.w*w.z;
        float phase=render.backdrop_animation.z-uv.x*PULSE_SPATIAL_FREQUENCY;
        float pulse=pow(max(0.0,sin(phase)),PRIMARY_PULSE_EXPONENT)+SECONDARY_PULSE_WEIGHT*pow(max(0.0,sin(phase-SECONDARY_PULSE_PHASE)),SECONDARY_PULSE_EXPONENT);
        vec3 ambient=render.background.rgb*mix(render.ambient_bottom.rgb,render.ambient_top.rgb,0.5+0.5*normal.y);
        for (int i=0;i<3;++i) ambient+=render.studio_color[i].rgb*(STUDIO_AMBIENT_WEIGHT*max(0.0,dot(normal,render.studio_direction[i].xyz)));
        color+=pigment*shape*(render.backdrop_style.y*(VEIN_BASE_GLOW+vein*pulse*VEIN_PULSE_GLOW)*(SILHOUETTE_FADE_COSINE+FACING_GLOW_WEIGHT*facing)
            +ambient*render.backdrop_style.z);
        // Current-view GGX highlights. No shadow rays: gameplay cannot cast onto
        // this decorative layer. Broad lobes survive the backdrop's spatial blur.
        float roughness=dot(vec3(a.color.w,b.color.w,c.color.w),w);
        if (roughness<0.9)
        {
            float ior=dot(vec3(a.position.w,b.position.w,c.position.w),w);
            float f0=(ior-1.0)/(ior+1.0);f0*=f0;
            float alpha=pow(max(roughness,0.18),2.0),alpha2=alpha*alpha;
            float nv=max(0.01,dot(normal,-direction));
            for (int i=0;i<3;++i)
            {
                vec3 light=render.studio_direction[i].xyz;
                float nl=max(0.0,dot(normal,light));
                vec3 half_vector=light-direction;
                if (nl<=0.0 || dot(half_vector,half_vector)<0.000001) continue;
                half_vector=normalize(half_vector);
                float nh=max(0.0,dot(normal,half_vector)),vh=max(0.0,dot(-direction,half_vector));
                float denominator=nh*nh*(alpha2-1.0)+1.0;
                float distribution=alpha2/(3.14159265*denominator*denominator);
                float gv=2.0*nv/(nv+sqrt(alpha2+(1.0-alpha2)*nv*nv));
                float gl=2.0*nl/max(0.001,nl+sqrt(alpha2+(1.0-alpha2)*nl*nl));
                float fresnel=f0+(1.0-f0)*pow(1.0-vh,5.0);
                color+=render.studio_color[i].rgb*(distribution*gv*gl*fresnel/(4.0*nv));
            }
        }
    }
    imageStore(background_a,pixel,vec4(color,distance));
}

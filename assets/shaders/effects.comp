#version 460
#extension GL_GOOGLE_include_directive : require
#include "render_bindings.glsl"
#include "render_uniform.glsl"
#include "debug_buffers.glsl"

const uint EFFECT_TILE_ROUNDING_PIXELS = 15u;
const uint EFFECT_TILE_SIZE_UNSIGNED = 16u;
const float MIN_SEGMENT_SQUARED_LENGTH = .0001;
const float RING_KIND_LOWER_BOUND = 1.5;
const float RING_KIND_UPPER_BOUND = 3.5;
const float SELECTION_KIND_LOWER_BOUND = 2.5;
const float BLAST_RING_RADIUS_SCALE = .75;
const float EDGE_FEATHER_PIXELS = .7;
const float EDGE_FEATHER_WIDTH_PIXELS = 1.4;
const float GUIDE_DEPTH_MARGIN = .12;
const float THIN_MEMBRANE_GUIDE_CODE = 3.0;
const float MEMBRANE_EFFECT_TRANSMISSION = .35;
const float BURST_LIGHT_GAIN = 4.0;
const float BURST_HALO_GAIN = .25;
const float RING_LIGHT_GAIN = 3.5;
const float TRAIL_LIGHT_GAIN = 1.5;
const float BURST_HALO_VARIANCE_SCALE = 3.0;

layout(local_size_x=COMPUTE_GROUP_SIZE,local_size_y=COMPUTE_GROUP_SIZE) in;
layout(set=0,binding = RENDER_BINDING_BEAUTY,rgba32f) uniform image2D beauty;
struct Segment { vec4 a,b,color; };
layout(set=0,binding = RENDER_BINDING_EFFECTS,std430) readonly buffer Segments { Segment segments[]; };
layout(set=0,binding = RENDER_BINDING_EFFECT_TILES,std430) readonly buffer Tiles { uint tiles[]; };
void main()
{
    uvec2 p=gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p,render.settings.xy))) return;
    uint width=(render.settings.x+EFFECT_TILE_ROUNDING_PIXELS)/EFFECT_TILE_SIZE_UNSIGNED,height=(render.settings.y+EFFECT_TILE_ROUNDING_PIXELS)/EFFECT_TILE_SIZE_UNSIGNED;
    uint tile=(p.y/EFFECT_TILE_SIZE_UNSIGNED)*width+p.x/EFFECT_TILE_SIZE_UNSIGNED,start=tiles[tile],end=tiles[tile+1u];
    if (start==end) return;
    uint index=p.y*render.settings.x+p.x,base=2u*width*height+1u;
    DebugPixel guide=debug_pixels[index];vec3 light=vec3(0);
    for (uint i=start;i<end;++i)
    {
        Segment s=segments[tiles[base+i]];vec2 delta=s.b.xy-s.a.xy;
        float t=clamp(dot(vec2(p)+.5-s.a.xy,delta)/max(MIN_SEGMENT_SQUARED_LENGTH,dot(delta,delta)),0.0,1.0);
        float distance=length(vec2(p)+.5-mix(s.a.xy,s.b.xy,t));
        float alpha;
        if (s.b.w>RING_KIND_LOWER_BOUND && s.b.w<RING_KIND_UPPER_BOUND)
        {
            float ring=abs(distance-s.a.w*(s.b.w>SELECTION_KIND_LOWER_BOUND ? 1.0 : BLAST_RING_RADIUS_SCALE));
            alpha=exp(-ring*ring/2.0)*clamp(1.0-distance/max(s.a.w,1.0),0.0,1.0)*RING_LIGHT_GAIN;
        }
        else alpha=clamp((s.a.w+EDGE_FEATHER_PIXELS-distance)/EDGE_FEATHER_WIDTH_PIXELS,0.0,1.0);
        float depth=mix(s.a.z,s.b.z,t);
        if (guide.vertex_hit.w>0.5 && guide.normal_depth.w>0.0 && depth>guide.normal_depth.w+GUIDE_DEPTH_MARGIN)
            alpha*=guide.vertex_hit.w==THIN_MEMBRANE_GUIDE_CODE ? render.thin_material.x*MEMBRANE_EFFECT_TRANSMISSION : 0.0;
        float strength=s.b.w<.5 ? TRAIL_LIGHT_GAIN : s.b.w<SELECTION_KIND_LOWER_BOUND ? BURST_LIGHT_GAIN : 1.0;
        if (s.b.w>.5 && s.b.w<RING_KIND_LOWER_BOUND)
            alpha+=exp(-distance*distance/max(1.0,s.a.w*s.a.w*BURST_HALO_VARIANCE_SCALE))*BURST_HALO_GAIN;
        light+=s.color.rgb*(s.color.a*alpha*strength);
    }
    vec4 value=imageLoad(beauty,ivec2(p));imageStore(beauty,ivec2(p),vec4(value.rgb+light,value.a));
}

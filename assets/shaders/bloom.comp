#version 460
#extension GL_GOOGLE_include_directive : require
#include "render_bindings.glsl"
#define NANOVA_DEBUG_BINDING BLOOM_BINDING_DEBUG
#include "debug_buffers.glsl"

const float SRGB_POWER_SCALE = 1.055;
const float SRGB_GAMMA = 2.4;
const float SRGB_POWER_OFFSET = 0.055;
const float SRGB_LINEAR_SCALE = 12.92;
const float SRGB_LINEAR_THRESHOLD = 0.0031308;
const float GAUSSIAN_RADIUS_SIGMAS = 3.0;
const float MIN_BLOOM_PEAK = 0.000001;

// Current-frame halo: downsample, two separable quarter-size blurs, then
// native display composition. Two disjoint tiles reuse HDR scratch storage.
layout(local_size_x = COMPUTE_GROUP_SIZE, local_size_y = COMPUTE_GROUP_SIZE) in;
layout(set = 0, binding = BLOOM_BINDING_BEAUTY, rgba32f) uniform readonly image2D beauty;
layout(set = 0, binding = BLOOM_BINDING_HORIZONTAL, rgba32f) uniform image2D horizontal;
layout(set = 0, binding = BLOOM_BINDING_DISPLAY, rgba8) uniform writeonly image2D display_image;
layout(push_constant) uniform Bloom
{
    ivec2 extent;
    int radius;
    int pass;
    float threshold;
    float strength;
    float exposure;
    float debug_views;
    uint emissive_only;
} bloom;
layout(set=0,binding=BLOOM_BINDING_SHARP_LAYER,std430) readonly buffer EmissionGuide { vec4 sharp_pixels[]; };

vec3 linear_to_srgb(vec3 linear)
{
    return mix(SRGB_POWER_SCALE * pow(linear, vec3(1.0 / SRGB_GAMMA)) - SRGB_POWER_OFFSET,
               SRGB_LINEAR_SCALE * linear, lessThanEqual(linear, vec3(SRGB_LINEAR_THRESHOLD)));
}

layout(constant_id=SPATIAL_AA_SPECIALIZATION_ID) const bool spatial_aa=false;

vec3 mapped_texel(ivec2 position,vec3 glow)
{
    vec3 linear=imageLoad(beauty,clamp(position,ivec2(0),bloom.extent-1)).rgb*bloom.exposure+glow;
    return linear/(vec3(1)+linear);
}
vec3 mapped_sample(vec2 position,vec3 glow)
{
    vec2 base=floor(position),f=position-base;
    ivec2 low=ivec2(base),last=bloom.extent-1;
    vec3 a=imageLoad(beauty,clamp(low,ivec2(0),last)).rgb;
    vec3 b=imageLoad(beauty,clamp(low+ivec2(1,0),ivec2(0),last)).rgb;
    vec3 c=imageLoad(beauty,clamp(low+ivec2(0,1),ivec2(0),last)).rgb;
    vec3 d=imageLoad(beauty,clamp(low+ivec2(1,1),ivec2(0),last)).rgb;
    vec3 linear=mix(mix(a,b,f.x),mix(c,d,f.x),f.y)*bloom.exposure+glow;
    return linear/(vec3(1)+linear);
}
float edge_luma(vec3 color)
{ return sqrt(max(0.0,dot(color,vec3(.299,.587,.114)))); }

// Directional spatial edge filtering, following the FXAA method. Only current
// native pixels are read. HUD and profiler are drawn after this pass.
vec3 antialias(ivec2 pixel,vec3 center,vec3 glow)
{
    vec2 p=vec2(pixel);
    float nw=edge_luma(mapped_texel(pixel+ivec2(-1,-1),glow));
    float ne=edge_luma(mapped_texel(pixel+ivec2(1,-1),glow));
    float sw=edge_luma(mapped_texel(pixel+ivec2(-1,1),glow));
    float se=edge_luma(mapped_texel(pixel+ivec2(1,1),glow));
    float luma=edge_luma(center);
    float low=min(luma,min(min(nw,ne),min(sw,se))),high=max(luma,max(max(nw,ne),max(sw,se)));
    if (high-low<max(.0156,high*.063)) return center;
    vec2 direction=vec2(sw+se-nw-ne,nw+sw-ne-se);
    float reduce=max((nw+ne+sw+se)*.03125,.0078125);
    direction=clamp(direction/(min(abs(direction.x),abs(direction.y))+reduce),vec2(-8),vec2(8));
    vec3 a=.5*(mapped_sample(p-direction/6.0,glow)+mapped_sample(p+direction/6.0,glow));
    vec3 b=.5*a+.25*(mapped_sample(p-direction*.5,glow)+mapped_sample(p+direction*.5,glow));
    float value=edge_luma(b);
    return value<low || value>high ? a : b;
}

void write_display(ivec2 pixel,vec3 linear)
{
    vec3 mapped=linear/(vec3(1.0)+linear);
    if (spatial_aa && bloom.debug_views<.5)
    {
        vec3 glow=linear-imageLoad(beauty,pixel).rgb*bloom.exposure;
        mapped=antialias(pixel,mapped,glow);
    }
    vec3 value=linear_to_srgb(mapped);
    imageStore(display_image,pixel,vec4(value,1.0));
    if (bloom.debug_views>.5)
        debug_pixels[pixel.y*bloom.extent.x+pixel.x].direct.w=
            uintBitsToFloat(packUnorm4x8(vec4(value,0.0)));
}

vec3 bright(vec3 value,ivec2 pixel)
{
    float peak=max(value.r,max(value.g,value.b));
    float source=bloom.emissive_only!=0u ? min(peak,sharp_pixels[pixel.y*bloom.extent.x+pixel.x].a) : peak;
    return value*max(0.0,source-bloom.threshold)/max(peak,MIN_BLOOM_PEAK);
}

vec3 halo_sample(ivec2 pixel,ivec2 extent)
{
    vec2 p=(vec2(pixel)+.5)/float(BLOOM_DOWNSAMPLE)-.5;
    ivec2 low=ivec2(floor(p));vec2 f=fract(p);ivec2 last=extent-1;
    vec3 a=imageLoad(horizontal,clamp(low,ivec2(0),last)).rgb;
    vec3 b=imageLoad(horizontal,clamp(low+ivec2(1,0),ivec2(0),last)).rgb;
    vec3 c=imageLoad(horizontal,clamp(low+ivec2(0,1),ivec2(0),last)).rgb;
    vec3 d=imageLoad(horizontal,clamp(low+ivec2(1,1),ivec2(0),last)).rgb;
    return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);
}

void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec2 small=(bloom.extent+BLOOM_DOWNSAMPLE-1)/BLOOM_DOWNSAMPLE;
    if (bloom.pass==BLOOM_COMPOSITE_PASS)
    {
        if (any(greaterThanEqual(pixel,bloom.extent))) return;
        vec3 glow=vec3(0);
        if (bloom.strength>0.0)
            glow=bloom.extent.y<2 ? bright(imageLoad(beauty,pixel).rgb,pixel) : halo_sample(pixel,small);
        write_display(pixel,(imageLoad(beauty,pixel).rgb+bloom.strength*glow)*bloom.exposure);
        return;
    }
    if (any(greaterThanEqual(pixel,small))) return;
    if (bloom.pass==0)
    {
        vec3 sum=vec3(0);float count=0;
        for (int y=0;y<BLOOM_DOWNSAMPLE;++y)
            for (int x=0;x<BLOOM_DOWNSAMPLE;++x)
            {
                ivec2 p=pixel*BLOOM_DOWNSAMPLE+ivec2(x,y);
                if (any(greaterThanEqual(p,bloom.extent))) continue;
                sum+=bright(imageLoad(beauty,p).rgb,p);count+=1;
            }
        imageStore(horizontal,pixel,vec4(sum/count,1));
        return;
    }
    int radius=max(1,(bloom.radius+BLOOM_DOWNSAMPLE-1)/BLOOM_DOWNSAMPLE);
    float sigma=max(.5,float(bloom.radius)/float(BLOOM_DOWNSAMPLE)/GAUSSIAN_RADIUS_SIGMAS);
    vec3 sum=vec3(0);float weights=0;
    for (int offset=-radius;offset<=radius;++offset)
    {
        float w=exp(-.5*float(offset*offset)/(sigma*sigma));
        ivec2 p=clamp(pixel+(bloom.pass==1 ? ivec2(offset,0) : ivec2(0,offset)),ivec2(0),small-1);
        if (bloom.pass==2) p.y+=small.y;
        sum+=imageLoad(horizontal,p).rgb*w;weights+=w;
    }
    ivec2 destination=pixel+(bloom.pass==1 ? ivec2(0,small.y) : ivec2(0));
    imageStore(horizontal,destination,vec4(sum/weights,1));
}

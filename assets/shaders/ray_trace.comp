struct InstanceStyle { vec4 tint,material,detail; };
layout(set=0,binding = RENDER_BINDING_INSTANCE_STYLES,std430) readonly buffer InstanceStyles { InstanceStyle instance_style[]; };

struct Surface
{
    vec3 point, normal, geometric_normal, color;
    float emission;
    bool translucent,unshadowed,front_face;
    vec4 subsurface;
    float detail,reveal,ambient; // Screen-space and fog level of detail; ambient light weight.

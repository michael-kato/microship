    else terminal=exp2(guides[index].z)-1.0;
    uint anchor=volume_anchor(pixel/volume_grid_stride);
    guides[anchor]=vec4(volume,log2(1.0+terminal));
    guides[anchor+1u]=vec4(sharp,0);
#elif defined(NANOVA_VOLUME_FILTER)
    uint index=pixel.y*render.settings.x+pixel.x;
    float depth=guides[index].z;
    uvec2 low=pixel/volume_grid_stride,extent=(render.settings.xy+volume_grid_stride-1u)/volume_grid_stride;
    vec2 f=vec2(pixel%uvec2(volume_grid_stride))/float(volume_grid_stride);
    vec3 volume=vec3(0),sharp=vec3(0);float total=0;
    for (uint y=0u;y<2u;++y) for (uint x=0u;x<2u;++x)

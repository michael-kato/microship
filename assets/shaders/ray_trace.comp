        if (clear<=0.0 || layer==render.settings.w) break;
        through_wall=true;
        weight*=clear*mix(vec3(1),s.color,CLEAR_MEMBRANE_PIGMENT_WEIGHT*opacity)*exp(-render.thin_material.y*opacity/max(MIN_MEMBRANE_DIRECTION_COSINE,view_cosine));
        origin=s.point-s.geometric_normal*point_epsilon(s.point);
    }
    return radiance;
}

vec2 film_sample(uint index,uint count)
{
    if (count==1u || ((count&1u)!=0u && index==count-1u)) return vec2(.5);
    uint pairs=count/CONDUCTOR_MATERIAL,pair=index/CONDUCTOR_MATERIAL;
    // Mirrored pairs keep the centroid at the pixel center for every count.
    // The fixed seed changes film positions only; no frame or pixel RNG exists.
    vec2 sample_value=vec2((float(pair)+.5)/float(pairs),
        fract(float(bitfieldReverse(pair^render.scene.x))*exp2(-BIT_REVERSE_WORD_BITS)+.5/float(pairs)));
    return (index&1u)==0u ? sample_value : vec2(1)-sample_value;
}

vec3 film_direction(uvec2 pixel, vec2 jitter)
{
    vec2 film = (vec2(pixel)+jitter)/vec2(render.settings.xy);
    vec2 ndc = vec2(2.0*film.x-1.0,1.0-2.0*film.y);
    return normalize(render.camera_forward.xyz +
        render.camera_right.xyz*(ndc.x*render.display.y*render.display.z) +
        render.camera_up.xyz*(ndc.y*render.display.y));
}

bool pixel_may_intersect_medium(uvec2 pixel)
{
    vec3 axis = film_direction(pixel,vec2(0.5));
    // Normalization is Lipschitz with bound 2/|D|; unnormalized camera rays
    // have |D| >= 1. This covers every subpixel direction, including silhouettes.
    float cone = min(2.0,PIXEL_DIAGONAL_CONE_FACTOR*render.display.y/float(render.settings.y));
    for (uint i = 0u; i < render.scene.y; ++i)
    {
        vec3 delta = media[i].center_radius.xyz-render.camera_position.xyz;
        float squared = dot(delta,delta), along = dot(delta,axis);
        float radius = media[i].center_radius.w+sqrt(squared)*cone;
        if (along+radius > 0.0 && squared-along*along <= radius*radius) return true;
    }
    return false;
}

bool pixel_is_vacuum(uvec2 pixel)
{
    vec3 origin = render.camera_position.xyz;
    vec3 axis = film_direction(pixel,vec2(0.5));
    // Every subpixel direction is within this chord distance of the center ray.
    // The small additional margin covers floating-point camera normalization.
    float cone = min(2.0,PIXEL_DIAGONAL_CONE_FACTOR*render.display.y/float(render.settings.y)+CAMERA_NORMALIZATION_MARGIN);
    vec3 center = 0.5*(render.scene_min.xyz+render.scene_max.xyz);
    float farthest = length(center-origin)+length(0.5*(render.scene_max.xyz-render.scene_min.xyz));
    if (isinf(farthest) || isnan(farthest)) return false;
    // A potential hit is at most farthest units away. Expanding every box axis
    // by farthest*cone encloses the entire pixel footprint at that distance.
    if (scene_box_intersection(origin,axis,RAY_MAX,farthest*cone+point_epsilon(center))) return false;
    for (uint i = 0u; i < render.scene.y; ++i)
    {
        vec3 delta = media[i].center_radius.xyz-origin;
        float radius = media[i].center_radius.w+length(delta)*cone;
        vec3 perpendicular = cross(delta,axis);
        if (dot(delta,axis)+radius > 0.0 && dot(perpendicular,perpendicular) <= radius*radius) return false;
    }
    return true;
}

bool pixel_only_background(uvec2 pixel)
{
    vec3 low=render.foreground_min.xyz,high=render.foreground_max.xyz;
    if (any(greaterThan(low,high))) return true;
    vec3 origin=render.camera_position.xyz,center=.5*(low+high);
    float farthest=length(center-origin)+length(.5*(high-low));
    if (isnan(farthest) || isinf(farthest)) return false;
    // Conservative subpixel cone plus an eight-pixel reconstruction guard band.
    float cone=min(2.0,FOREGROUND_GUARD_DIAMETER_PIXELS*PIXEL_DIAGONAL_CONE_FACTOR*render.display.y/float(render.settings.y)+FOREGROUND_NORMALIZATION_MARGIN);
    return !box_intersection(origin,film_direction(pixel,vec2(.5)),RAY_MAX,
        farthest*cone+point_epsilon(center),low,high);
}

vec3 integrate_volume(uvec2 pixel,out vec3 sharp_result,out float terminal)
{
    uint volume_count = render.scene.y > 0u ? render.quality.x : 0u;
    vec3 volume_sum = vec3(0.0),sharp_volume_sum=vec3(0.0);terminal=RAY_MAX;
    for (uint sample_index = 0u; sample_index < volume_count; ++sample_index)
    {
        vec3 direction=film_direction(pixel,film_sample(sample_index,volume_count));
        vec3 origin=render.camera_position.xyz,weight=vec3(1);
        float sharp_limit=medium_sharp_limit(direction);
        for (uint depth=0u;depth<=render.settings.w;++depth)
        {
            uint triangle;vec2 barycentric;float distance;
            bool hit=closest_hit(origin,direction,triangle,barycentric,distance);
            if (!hit && render.backdrop_style.x>0.0)
                distance=backdrop_remaining(origin,direction,pixel);
            terminal=dot(origin-render.camera_position.xyz,direction)+distance;
            vec3 sharp;
            vec3 scattering=weight*single_scattering(origin,direction,distance,sharp_limit,sharp);
            volume_sum+=scattering;sharp_volume_sum+=weight*sharp;
            if (!hit || depth==render.settings.w) break;
            Surface s;if (!surface_at(triangle,barycentric,direction,s) || !s.translucent) break;
            float view_cosine=abs(dot(s.normal,direction)),opacity=membrane_opacity(view_cosine);
            float clear=membrane_clear(view_cosine);if (clear<=0.0) break;
            weight*=transmittance(origin,direction,distance)*clear*mix(vec3(1),s.color,CLEAR_MEMBRANE_PIGMENT_WEIGHT*opacity)
                *exp(-render.thin_material.y*opacity/max(MIN_MEMBRANE_DIRECTION_COSINE,view_cosine));
            origin=s.point-s.geometric_normal*point_epsilon(s.point);
        }
    }
    sharp_result=volume_count>0u ? sharp_volume_sum/float(volume_count) : vec3(0);
    return volume_count>0u ? volume_sum/float(volume_count) : vec3(0);
}

#ifdef NANOVA_DEBUG_BUFFERS
// Volume anchors follow the per-pixel guides: two entries per stride cell.
uint volume_anchor(uvec2 cell)
{
    uint width=(render.settings.x+volume_grid_stride-1u)/volume_grid_stride;
    return render.settings.x*render.settings.y+2u*(cell.y*width+cell.x);
}
#endif

#ifdef NANOVA_SHADOW_GRID_PASS
layout(push_constant) uniform GridPass { uint medium;uint pass;uint instance;uint triangle_count; } grid_pass;
void main()
{
    if (grid_pass.pass==LIGHTING_PASS_SURFACE)
    {
        uint local=gl_GlobalInvocationID.x,corner=gl_GlobalInvocationID.y;
        if (local>=grid_pass.triangle_count || corner>=6u) return;
        LightingInstance instance=lighting_instances[grid_pass.instance];
        uint triangle_index=instance.range.x+local;uvec4 triangle=triangles[triangle_index];
        if (triangle.w!=THIN_MEMBRANE_MATERIAL && !organelle_lighting_cache) return;

        if (clear<=0.0 || layer==render.settings.w) break;
        through_wall=true;
        weight*=clear*mix(vec3(1),s.color,CLEAR_MEMBRANE_PIGMENT_WEIGHT*opacity)*exp(-render.thin_material.y*opacity/max(MIN_MEMBRANE_DIRECTION_COSINE,view_cosine));
        origin=s.point-s.geometric_normal*point_epsilon(s.point);
    }

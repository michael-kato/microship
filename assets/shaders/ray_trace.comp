                sample_value.front_face=corner<3u;sample_value.instance=grid_pass.instance;
                uint vertex=corner%3u==0u ? triangle.x : corner%3u==1u ? triangle.y : triangle.z;
                vec4 material=vertices[vertex].subsurface;
                float scale=min(length(vec3(instance.row0.x,instance.row1.x,instance.row2.x)),
                    min(length(vec3(instance.row0.y,instance.row1.y,instance.row2.y)),length(vec3(instance.row0.z,instance.row1.z,instance.row2.z))));
                float radius=max(material.r,max(material.g,material.b))*scale;

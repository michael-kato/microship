    vec3 point=m.center_radius.xyz+m.center_radius.w*(2.0*vec3(p)/float(n-1u)-1.0);
    if (grid_pass.pass==LIGHTING_PASS_DYNAMIC)
        point=mix(lighting_bounds[grid_pass.medium].low.xyz,lighting_bounds[grid_pass.medium].high.xyz,vec3(p)/float(n-1u));
    for (uint light=0u;light<3u;++light)
    {

        vec3 origin=render.camera_position.xyz,weight=vec3(1);
        float sharp_limit=medium_sharp_limit(direction);
        for (uint depth=0u;depth<=render.settings.w;++depth)
        {
            uint triangle;vec2 barycentric;float distance;
            bool hit=closest_hit(origin,direction,triangle,barycentric,distance);
            if (!hit && render.backdrop_style.x>0.0)
                distance=backdrop_remaining(origin,direction,pixel);
            terminal=dot(origin-render.camera_position.xyz,direction)+distance;
            vec3 sharp;
            vec3 scattering=weight*single_scattering(origin,direction,distance,sharp_limit,sharp);
            volume_sum+=scattering;sharp_volume_sum+=weight*sharp;
            if (!hit || depth==render.settings.w) break;

    if (render.backdrop_style.x>0.0 && pixel_is_vacuum(pixel))
    {
        if (render.background_quality.w>0u) sharp_pixels[pixel.y*render.settings.x+pixel.x].a=0.0;
        vec3 background=texelFetch(soft_backdrop,ivec2(pixel),0).rgb;

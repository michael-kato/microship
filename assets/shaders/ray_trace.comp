    uint flags=uint(instance_style[hit_instance].material.w);
    if ((flags&2u)==0u || surface.translucent) surface.color=mix(surface.color,tint.rgb,tint.a);
    surface.emission=surface.translucent ? 0.0 : (surface.emission+instance_style[hit_instance].material.x)*render.membrane_fade.w;
    if ((flags&4u)!=0u)
    {
        float facing=clamp(dot(normal,-direction),0.0,1.0);
        float edge=1.0-smoothstep(0.0,render.organelle_style.y,facing);
        float grey=dot(surface.color,vec3(.2126,.7152,.0722));
        float saturation=mix(1.0,render.organelle_style.x,edge);
        surface.color=clamp(mix(vec3(grey),surface.color,saturation),vec3(0),vec3(1));
        surface.emission*=render.organelle_style.z*pow(max(facing,1e-6),render.organelle_style.w);
    }

    c.position.xyz=hit_to_world*vec4(c.position.xyz,1.0);
    a.normal.xyz=hit_normal_to_world*a.normal.xyz;
    b.normal.xyz=hit_normal_to_world*b.normal.xyz;
    c.normal.xyz=hit_normal_to_world*c.normal.xyz;

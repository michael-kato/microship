    if (volume_lighting_grid && n>0u && medium.lighting.x<=0.0 && medium.lighting.z>0.0)
    {
        vec3 q=clamp((point-medium.center_radius.xyz+medium.center_radius.w)/(2.0*medium.center_radius.w)*float(n-1u),vec3(0),vec3(n-1u));
        return interpolated_volume_lighting(medium_index,q,ambient,phases,cascade_ambient,cascade_weight);
    }
    bool shared_grid=n>0u && render.studio_direction[0].w>0.0 && render.studio_direction[1].w>0.0 && render.studio_direction[2].w>0.0;
    if (medium.lighting.x>0.0 && shared_grid)
        for (uint i=0u;i<render.scene.y;++i)
        {
            vec3 q;if (grid_coordinates(i,point,vec3(0),q))
                return interpolated_volume_lighting(i,q,ambient,phases,cascade_ambient,cascade_weight);
        }
    vec3 incident=mix(ambient,cascade_ambient,cascade_weight);
    for (int light=0;light<3;++light)
    {
        if (render.studio_direction[light].w<=0.0) continue;
        vec3 direction=render.studio_direction[light].xyz;
        vec3 visibility=medium.lighting.x>0.0 ? (shared_grid ? studio_visibility(point,direction) : sampled_visibility(point,vec3(0),light)) : transmittance(point,direction,RAY_MAX);
        incident+=phases[light]*render.studio_color[light].rgb*visibility;
    }
    return incident;
}

float scattering_weight(Surface s)
{
    return !subsurface_enabled || s.unshadowed ? 0.0 : s.subsurface.a*render.subsurface.x;
}

// Fuzz: Charlie sheen distribution (Estevez and Kulla 2017) with Neubelt and
// Pettineo's visibility. Fibres along the surface glow toward grazing angles.
vec3 sheen_lobe(Surface s,vec3 outgoing,vec3 incoming,float ni)
{
    float strength=render.electron[1].y,no=dot(s.normal,outgoing);
    if (strength<=0.0 || no<=0.0) return vec3(0);
    vec3 half_vector=normalize(incoming+outgoing);
    float inverse=1.0/render.electron[1].z,nh=max(0.0,dot(s.normal,half_vector));
    float distribution=(2.0+inverse)*pow(max(0.0,1.0-nh*nh),.5*inverse)/(2.0*PI);
    return s.color*(strength*distribution/(4.0*(ni+no-ni*no)));
}

// Secondary-electron look: every surface emits, brighter as it tilts away
// from the view (the beam) and darker where relief creases trap the signal.
// It shades the camera image only; cascades never bounce it.
vec3 electron_signal(Surface s,vec3 outgoing)
{
    float facing=clamp(dot(s.normal,outgoing),0.0,1.0);
    return s.color*render.electron[0].rgb*s.occlusion*(1.0+render.electron[0].w*pow(1.0-facing,render.electron[1].x));
}

vec3 evaluate_studio(Surface s,vec3 outgoing,int selected,out vec3 sss)
{
    sss=vec3(0);
    if (render.studio_direction[selected].w<=0.0) return vec3(0);
    vec3 direction=render.studio_direction[selected].xyz;
    float cosine=dot(s.normal,direction),geometric_cosine=dot(s.geometric_normal,direction);
    float transmission=s.translucent ? membrane_transmission(max(0.0,dot(s.normal,outgoing))) : 0.0;
    float scatter=scattering_weight(s);vec3 weighted=vec3(0);
    float wrap=render.subsurface.y;
    bool front=s.translucent || geometric_cosine>0.0;
    // Diffuse reflection and fuzz; there is no specular lobe. It needs the geometric
    // front. Scattered light wraps past the smooth shading terminator instead,
    // so faceted triangles do not switch it.
    if ((front && cosine>0.0) || (scatter>0.0 && cosine+wrap>0.0))
    {
        vec3 reflected=front && cosine>0.0 && dot(s.normal,outgoing)>0.0
            ? (s.color*((1.0-scatter)/PI)+sheen_lobe(s,outgoing,direction,cosine))*cosine : vec3(0);
        if (scatter>0.0)
        {
            // Wrapped diffusion falls continuously to zero at cosine = -wrap and is
            // normalized over that support for walls and solid organelles alike.
            float diffuse=max(0.0,cosine+wrap)/((1.0+wrap)*(1.0+wrap));
            sss=s.color*(scatter*(1.0-render.subsurface.z)*diffuse/PI);
            reflected+=sss;
        }
        weighted=(1.0-transmission)*reflected*render.studio_color[selected].rgb;
    }
    if (cosine<0.0 && (s.translucent || geometric_cosine<0.0) && transmission>0.0)
        weighted+=s.color*((1.0-scatter)*transmission*(1.0-render.thin_material.w)*(-cosine)/PI)*
            exp(-render.thin_material.y/max(MIN_MEMBRANE_DIRECTION_COSINE,-cosine))*render.studio_color[selected].rgb;
    if (max(weighted.r,max(weighted.g,weighted.b))<=0.0) { sss=vec3(0);return vec3(0); }
    vec3 origin=s.point+s.geometric_normal*(geometric_cosine>0.0 ? point_epsilon(s.point) : -point_epsilon(s.point));
    vec3 visibility=vec3(1),diffused_visibility=vec3(1);
    if (!s.unshadowed && s.reveal>0.0)
    {
        // Thin walls use their baked samples. Opaque receivers trace exact current
        // shadows for surface reflection; light diffused under the surface keeps the
        // smooth field, since scattering blurs it over the mean free path anyway.
        if (s.translucent || scatter>0.0)
            diffused_visibility=baked_surface_visibility(s,selected,geometric_cosine<=0.0,origin);
        // Cascade rays shade indirect light; the smooth current field is enough there.
        visibility=transparent_pass || s.translucent || geometric_cosine<=0.0 ? diffused_visibility
            : cascade_tracing ? sampled_visibility(origin,s.geometric_normal,selected) : studio_visibility(origin,direction);
        // Under fog the blurred map needs no shadows; they fade in as it is revealed.
        visibility=mix(vec3(1),visibility,s.reveal);diffused_visibility=mix(vec3(1),diffused_visibility,s.reveal);
    }
    sss*=(1.0-transmission)*render.studio_color[selected].rgb*diffused_visibility;
    return (weighted-sss)*visibility+sss;
}

bool subsurface_exit(Surface s,vec3 direction,float limit,out vec3 exit_point,out float thickness)
{
    float epsilon=point_epsilon(s.point);
    vec3 origin=s.point-s.geometric_normal*epsilon;
    rayQueryEXT query;
#if defined(NANOVORE_DEBUG_BUFFERS) && !defined(NANOVORE_NO_QUERY_COUNTERS)
    ++debug_shadow_queries;
#endif
    // Other instances cannot be this surface's exit. Drop the opposite blocker
    // class before traversal; the instance check below still selects this object.
    uint mask=uint(instance_style[s.instance].detail.w);
    if (mask==0u) mask=SURFACE_RAY_MASK;
    rayQueryInitializeEXT(query,scene_acceleration,gl_RayFlagsNoOpaqueEXT,mask,origin,0.0,direction,limit);
    while (rayQueryProceedEXT(query))
    {
        if (rayQueryGetIntersectionTypeEXT(query,false)!=gl_RayQueryCandidateIntersectionTriangleEXT) continue;
        if (rayQueryGetIntersectionInstanceIdEXT(query,false)!=s.instance || rayQueryGetIntersectionFrontFaceEXT(query,false)==s.front_face) continue;
        uint triangle=hit_triangle(rayQueryGetIntersectionInstanceCustomIndexEXT(query,false),
            rayQueryGetIntersectionGeometryIndexEXT(query,false),rayQueryGetIntersectionPrimitiveIndexEXT(query,false));
        // A cell mesh contains both a hollow wall and solid organelles. The wall is not an organelle exit.
        if (triangles[triangle].w!=0u) continue;
        rayQueryConfirmIntersectionEXT(query);
    }
    if (rayQueryGetIntersectionTypeEXT(query,true)==gl_RayQueryCommittedIntersectionNoneEXT) return false;
    thickness=rayQueryGetIntersectionTEXT(query,true)+epsilon;
    exit_point=origin+direction*(thickness-epsilon);
    return true;
}

bool baked_subsurface_exit(Surface s,int light,out vec3 entry,out float thickness)
{
    if (!organelle_lighting_cache || !lighting_cached()) return false;
    LightingInstance instance=lighting_instances[s.instance];
    if (instance.range.w==0u) return false;
    uint first=(s.triangle-instance.range.x+instance.range.z)*SURFACE_LIGHTING_RECORDS_PER_TRIANGLE
        +(s.front_face ? 0u : 9u)+uint(light);
    vec4 a=surface_visibility[first],b=surface_visibility[first+3u],c=surface_visibility[first+6u];
    // A missing corner exit cannot be interpolated across a topology boundary.
    if (min(a.w,min(b.w,c.w))<=0.0) return false;
    vec4 sample_value=a*s.barycentric.x+b*s.barycentric.y+c*s.barycentric.z;
    entry=sample_value.xyz;thickness=sample_value.w;return true;
}

vec3 evaluate_subsurface(Surface s,vec3 outgoing)
{
    float scatter=scattering_weight(s);
    float radius=max(s.subsurface.r,max(s.subsurface.g,s.subsurface.b));
    if (scatter<=0.0 || radius<=0.0 || render.subsurface.z<=0.0) return vec3(0);
    // One geometric thickness query per surface at most. Use the strongest back light.
    int selected=-1;float best=0.0;
    for (int light=0;light<3;++light)
    {
        float cosine=-dot(s.translucent ? s.normal : s.geometric_normal,render.studio_direction[light].xyz);
        float score=cosine*render.studio_direction[light].w;
        if (score>best) { best=score;selected=light; }
    }
    if (selected<0) return vec3(0);
    vec3 direction=render.studio_direction[selected].xyz,entry;float thickness;
    float cosine=max(0.0,-dot(s.normal,direction));
    if (cosine<=0.0) return vec3(0);
    if (transparent_pass || s.translucent)
    {
        // The wall encloses fluid. Its authored thickness is not the cell diameter.
        thickness=render.subsurface.w/max(MIN_MEMBRANE_DIRECTION_COSINE,cosine);
        entry=s.point+direction*point_epsilon(s.point);
    }
    else
    {
        bool cached=false;
        if (organelle_lighting_cache) cached=baked_subsurface_exit(s,selected,entry,thickness);
        if (!cached && !subsurface_exit(s,direction,8.0*radius,entry,thickness)) return vec3(0);
    }
    vec3 attenuation=exp(-thickness/max(s.subsurface.rgb,vec3(MIN_SHADING_DENOMINATOR)));
    float clear_budget=s.translucent ? 1.0-membrane_transmission(max(0.0,dot(s.normal,outgoing))) : 1.0;
    vec3 light=s.color*attenuation*(scatter*render.subsurface.z*clear_budget*cosine/PI)*render.studio_color[selected].rgb;
    // Query from the light-entry side. Other objects must still cast shadows.
    // The entry can lie outside the surface hit's medium, so scan every medium there.
    uint scan_first=medium_scan_first;medium_scan_first=0u;
    vec3 visibility=s.translucent && lighting_cached() && lighting_instances[s.instance].range.w>0u ? baked_surface_visibility(s,selected,true,entry+direction*point_epsilon(entry))
        : sampled_visibility(entry+direction*point_epsilon(entry),direction,selected);
    medium_scan_first=scan_first;
    return light*visibility;
}

const float COSINE_GRADIENT_DENOMINATOR=3.0;

vec3 ambient_surface(Surface s,vec3 outgoing)
{
    // Inside active cells, radiance cascades supply incoming light: occlusion,
    // studio light and glow bounced from nearby surfaces. Elsewhere this is the
    // cosine-weighted integral of the authored linear environment gradient, times
    // the baked ambient visibility. Small or fogged cells blend the incoming light
    // toward the gradient with their cascade weight; the response is shaded once.
    if (s.ambient<=0.0) return vec3(0);
    vec3 sh[4];float weight;bool cascaded=cascade_lighting(s.point,s.geometric_normal,sh,weight);
    if (!cascaded) weight=0.0;
    float cosine=max(0.0,dot(s.normal,outgoing));
    float transmission=s.translucent ? membrane_transmission(max(0.0,dot(s.normal,outgoing))) : 0.0;
    vec3 diffuse=vec3(0),behind=vec3(0);
    if (weight<1.0)
    {
        float visibility=ambient_visibility(s.point,s.geometric_normal)*(1.0-weight);
        diffuse=visibility*render.background.rgb*mix(render.ambient_bottom.rgb,render.ambient_top.rgb,.5+s.normal.y/COSINE_GRADIENT_DENOMINATOR);
        behind=visibility*render.background.rgb*mix(render.ambient_bottom.rgb,render.ambient_top.rgb,.5-s.normal.y/COSINE_GRADIENT_DENOMINATOR);
    }
    if (weight>0.0)
    {
        diffuse+=weight*sh_irradiance(sh,s.normal);
        if (transmission>0.0) behind+=weight*sh_irradiance(sh,-s.normal);
    }
    vec3 result=s.color*diffuse*(1.0-transmission);
    if (transmission>0.0)
        result+=s.color*behind*(transmission*(1.0-render.thin_material.w))*
            exp(-render.thin_material.y/max(MIN_MEMBRANE_DIRECTION_COSINE,cosine));
    return result*s.ambient*s.occlusion;
}

vec3 surface_glow_color(Surface s)
{
    if ((uint(instance_style[s.instance].material.w)&8u)!=0u && render.emission_color.w>0.0)
        return render.emission_color.rgb;
    return s.color;
}

// The soft backdrop already has one current-frame center hit. Its unfiltered
// log distance stops transport behind that surface, including clear wall chains.
// Half-float quantization and the center footprint are backdrop approximations.
float backdrop_remaining(vec3 origin,vec3 direction,uvec2 pixel)
{
    float encoded=texelFetch(soft_backdrop,ivec2(pixel),0).a;
    float distance=encoded<128.0 ? exp2(encoded)-1.0 : RAY_MAX;
    return max(0.0,distance-dot(origin-render.camera_position.xyz,direction));
}

vec3 trace_direct(vec3 origin,vec3 direction,uint sample_index,uvec2 pixel,float subsurface_sample_weight)
{
    vec3 radiance=vec3(0),weight=vec3(1);float path_distance=0;bool through_wall=false;
    float sharp_limit=fused_volume ? medium_sharp_limit(direction) : RAY_MAX;
    // The limit counts transparent crossings. An opaque surface after the last
    // allowed crossing can still be shaded. Exhaustion does not reveal the sky.
    for (uint layer=0u;layer<=render.settings.w;++layer)
    {
        uint triangle;vec2 barycentric;float distance;
        bool hit=closest_hit(origin,direction,triangle,barycentric,distance);
        if (!hit && render.backdrop_style.x>0.0)
            distance=backdrop_remaining(origin,direction,pixel);
        if (fused_volume && render.quality.x>0u)
        {
            vec3 sharp;
            vec3 volume=weight*single_scattering(origin,direction,distance,sharp_limit,sharp);
            radiance+=volume;film_volume+=volume;film_sharp_sum+=weight*sharp;
        }
        weight*=transmittance(origin,direction,distance);
        path_distance+=distance;
        if (sample_index==0u) film_terminal_distance=path_distance;
        float blur_radius=max(medium_blur_radius(direction,path_distance),through_wall ? render.membrane_fade.z : 0.0);
        film_blur_max=max(film_blur_max,blur_radius);
        if (!hit)
        {
            vec3 background=render.backdrop_style.x>0.0 ? texelFetch(soft_backdrop,ivec2(pixel),0).rgb : environment_radiance(direction);
            radiance+=weight*background;
            if (blur_radius<=0.0) film_sharp_sum+=weight*background;
#ifdef NANOVORE_DEBUG_BUFFERS
            debug_direct+=weight*background;
#endif
            break;
        }
        Surface s;if (!surface_at(triangle,barycentric,direction,s)) break;
        medium_scan_first=first_medium_near(s.point,4.0*point_epsilon(s.point));
#ifdef NANOVORE_DEBUG_BUFFERS
        if (layer==0u)
        {
            ++debug_primary_hits;
            if (sample_index==0u)
            {
                debug_vertex_hit=vec4(s.color,s.translucent ? THIN_MEMBRANE_GUIDE_CODE : 1.0);
                debug_normal_depth=vec4(s.normal,distance);
            }
        }
#endif
        if (transparent_pass && !s.translucent)
        {
            opaque_hit=uvec4(triangle,hit_instance,floatBitsToUint(barycentric));
            opaque_weight=weight;opaque_flags=blur_radius<=0.0 ? 1.0 : 0.0;
            break;
        }
        vec3 glow_color=surface_glow_color(s);
        vec3 direct=glow_color*s.emission+electron_signal(s,-direction);
        vec3 sss=vec3(0);
        for (int light=0;light<3;++light)
        { vec3 contribution;direct+=evaluate_studio(s,-direction,light,contribution);sss+=contribution; }
        if (subsurface_sample_weight>0.0)
        { vec3 contribution=subsurface_sample_weight*evaluate_subsurface(s,-direction);direct+=contribution;sss+=contribution; }
        float view_cosine=abs(dot(s.normal,direction));
        float opacity=s.translucent ? membrane_opacity(view_cosine) : 1.0;
        film_emission+=weight*glow_color*s.emission*opacity;
        vec3 contribution=weight*(direct+ambient_surface(s,-direction))*opacity;
        radiance+=contribution;
        if (blur_radius<=0.0) film_sharp_sum+=contribution;
        // Fused volume samples at the next layer lie elsewhere along the ray.
        medium_scan_first=0u;
#ifdef NANOVORE_DEBUG_BUFFERS
        debug_direct+=weight*direct*opacity;debug_sss+=weight*sss*opacity;
#endif

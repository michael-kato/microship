struct Medium
{
    vec4 center_radius;
    vec4 scattering; // RGB coefficient; W outer fade fraction.
    vec4 absorption_phase;
    vec4 lighting;
    vec4 blur;
    vec4 detail; // Projected radius in pixels, fog reveal, moving-shadow weight, cascade weight.

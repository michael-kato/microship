const float RELATIVE_RAY_ORIGIN_OFFSET = 0.00001;
const uint THIN_MEMBRANE_MATERIAL = 3u;
const float MIN_SHADING_DENOMINATOR = 0.000001;
const float MIN_MEMBRANE_DIRECTION_COSINE = .2;
const float CLEAR_MEMBRANE_PIGMENT_WEIGHT = .15;
const float DIFFUSE_MEMBRANE_PIGMENT_WEIGHT = .35;
const float BIT_REVERSE_WORD_BITS = 32.0;
const float PIXEL_DIAGONAL_CONE_FACTOR = 2.828427125;
const float CAMERA_NORMALIZATION_MARGIN = 0.00002;

const float MIN_RAY_ORIGIN_OFFSET = 0.0001;
const float RELATIVE_RAY_ORIGIN_OFFSET = 0.00001;
const uint THIN_MEMBRANE_MATERIAL = 3u;
const float MIN_SHADING_DENOMINATOR = 0.000001;
const float SCHLICK_EXPONENT = 5.0;
const float MIN_ENERGY_TABLE_COSINE = 0.001;
const float ENERGY_TABLE_LAST_COORDINATE = 31.0;
const uint ENERGY_TABLE_LAST_CELL = 30u;
const uint ENERGY_TABLE_ROW_STRIDE = 32u;
const uint ENERGY_TABLE_DIAGONAL_OFFSET = 33u;
const float DIFFUSE_ROUGHNESS_THRESHOLD = 0.999;
const float SPECULAR_FADE_ROUGHNESS = 0.95;
const float SPECULAR_FADE_IOR = 1.05;
const float MIN_GGX_ALPHA = 0.002;
const uint CONDUCTOR_MATERIAL = 2u;
const float MIN_MEMBRANE_DIRECTION_COSINE = .2;
const float CLEAR_MEMBRANE_PIGMENT_WEIGHT = .15;
const float DIFFUSE_MEMBRANE_PIGMENT_WEIGHT = .35;
const float BIT_REVERSE_WORD_BITS = 32.0;
const float PIXEL_DIAGONAL_CONE_FACTOR = 2.828427125;
const float CAMERA_NORMALIZATION_MARGIN = 0.00002;
const float FOREGROUND_GUARD_DIAMETER_PIXELS = 17.0;
const float FOREGROUND_NORMALIZATION_MARGIN = .00002;

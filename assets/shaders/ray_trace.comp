bool pixel_may_intersect_medium(uvec2 pixel)
{
    vec3 axis = film_direction(pixel,vec2(0.5));
    // Normalization is Lipschitz with bound 2/|D|; unnormalized camera rays
    // have |D| >= 1. This covers every subpixel direction, including silhouettes.
    float cone = min(2.0,PIXEL_DIAGONAL_CONE_FACTOR*render.display.y/float(render.settings.y));
    for (uint i = 0u; i < render.scene.y; ++i)
    {
        vec3 delta = media[i].center_radius.xyz-render.camera_position.xyz;
        float squared = dot(delta,delta), along = dot(delta,axis);
        float radius = media[i].center_radius.w+sqrt(squared)*cone;
        if (along+radius > 0.0 && squared-along*along <= radius*radius) return true;
    }
    return false;
}

bool pixel_is_vacuum(uvec2 pixel)
{
    vec3 origin = render.camera_position.xyz;
    vec3 axis = film_direction(pixel,vec2(0.5));
    // Every subpixel direction is within this chord distance of the center ray.
    // The small additional margin covers floating-point camera normalization.
    float cone = min(2.0,PIXEL_DIAGONAL_CONE_FACTOR*render.display.y/float(render.settings.y)+CAMERA_NORMALIZATION_MARGIN);
    vec3 center = 0.5*(render.scene_min.xyz+render.scene_max.xyz);
    float farthest = length(center-origin)+length(0.5*(render.scene_max.xyz-render.scene_min.xyz));
    if (isinf(farthest) || isnan(farthest)) return false;
    // A potential hit is at most farthest units away. Expanding every box axis
    // by farthest*cone encloses the entire pixel footprint at that distance.
    if (scene_box_intersection(origin,axis,RAY_MAX,farthest*cone+point_epsilon(center))) return false;
    for (uint i = 0u; i < render.scene.y; ++i)
    {
        vec3 delta = media[i].center_radius.xyz-origin;
        float radius = media[i].center_radius.w+length(delta)*cone;
        vec3 perpendicular = cross(delta,axis);
        if (dot(delta,axis)+radius > 0.0 && dot(perpendicular,perpendicular) <= radius*radius) return false;
    }
    return true;
}

bool pixel_only_background(uvec2 pixel)
{
    vec3 low=render.foreground_min.xyz,high=render.foreground_max.xyz;
    if (any(greaterThan(low,high))) return true;
    vec3 origin=render.camera_position.xyz,center=.5*(low+high);
    float farthest=length(center-origin)+length(.5*(high-low));
    if (isnan(farthest) || isinf(farthest)) return false;
    // Conservative subpixel cone plus an eight-pixel reconstruction guard band.
    float cone=min(2.0,FOREGROUND_GUARD_DIAMETER_PIXELS*PIXEL_DIAGONAL_CONE_FACTOR*render.display.y/float(render.settings.y)+FOREGROUND_NORMALIZATION_MARGIN);
    return !box_intersection(origin,film_direction(pixel,vec2(.5)),RAY_MAX,
        farthest*cone+point_epsilon(center),low,high);
}

vec3 integrate_volume(uvec2 pixel,out vec3 sharp_result,out float terminal)
{
    uint volume_count = render.scene.y > 0u ? render.quality.x : 0u;
    vec3 volume_sum = vec3(0.0),sharp_volume_sum=vec3(0.0);terminal=RAY_MAX;
    for (uint sample_index = 0u; sample_index < volume_count; ++sample_index)
    {

// Procedural relief: fixed object-space height fields, so detail stays on
// moving objects and every frame shades the same surface. Analytic gradients
// tilt the shading normal; each layer fades out below a few pixels per feature.
uvec3 relief_hash(ivec3 cell)
{
    // pcg3d (Jarzynski and Olano 2020).
    uvec3 v=uvec3(cell)*1664525u+1013904223u;
    v.x+=v.y*v.z;v.y+=v.z*v.x;v.z+=v.x*v.y;v^=v>>16u;
    v.x+=v.y*v.z;v.y+=v.z*v.x;v.z+=v.x*v.y;return v;
}
vec3 relief_random(ivec3 cell) { return vec3(relief_hash(cell)>>8u)*(1.0/16777216.0); }
// Perlin gradient noise: value in about [-.7,.7] and its gradient. Corners
// accumulate one at a time with their quintic trilinear weights.
vec4 gradient_noise(vec3 p)
{
    ivec3 base=ivec3(floor(p));vec3 f=fract(p);
    vec3 u=f*f*f*(f*(f*6.0-15.0)+10.0),du=30.0*f*f*(f*(f-2.0)+1.0);
    vec4 sum=vec4(0);
    for (int k=0;k<8;++k)
    {
        vec3 o=vec3(k&1,(k>>1)&1,k>>2),w=mix(1.0-u,u,o),side=2.0*o-1.0;
        vec3 slope=normalize(relief_random(base+ivec3(o))*2.0-1.0+1e-4);
        float ramp=dot(slope,f-o),weight=w.x*w.y*w.z;
        sum+=vec4(weight*ramp,weight*slope+ramp*du*side*vec3(w.y*w.z,w.x*w.z,w.x*w.y));
    }
    return sum;
}
// Rounded cellular domes: height 1 at a jittered site, 0 where neighbors meet.
vec4 cellular_domes(vec3 p)
{
    ivec3 base=ivec3(floor(p));vec3 f=fract(p);
    float nearest=8.0;vec3 offset=vec3(0);
    for (int k=0;k<27;++k)
    {
        ivec3 o=ivec3(k%3,(k/3)%3,k/9)-1;
        vec3 d=vec3(o)+.15+.7*relief_random(base+o)-f;float d2=dot(d,d);
        if (d2<nearest) { nearest=d2;offset=d; }
    }
    float open=max(0.0,1.0-nearest);
    // h=open^2, so grad h = 2*open*grad(open) and grad(open) = 2*offset.
    return vec4(open*open,4.0*open*offset);
}
// Layer weight from object-space wavelength over object-space pixel footprint;
// zero depth disables the layer.
float relief_detail(float frequency,float depth,float footprint)
{ return depth>0.0 ? smoothstep(2.0,6.0,1.0/(frequency*footprint)) : 0.0; }
void apply_relief(inout Surface s,vec3 object_point,float instance_scale)
{
    float footprint=length(s.point-render.camera_position.xyz)*2.0*render.display.y/float(render.settings.y)/instance_scale;

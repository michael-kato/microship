#version 460
#extension GL_GOOGLE_include_directive : require
#define MICROSHIP_DEBUG_BINDING 2
#include "debug_buffers.glsl"

// Three native-resolution, edge-aware a-trous passes over indirect HDR.
// Direct/camera radiance and volume scattering remain unchanged.
// Source/destination images are distinct; all guides are fresh path results.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba32f) uniform readonly image2D source_image;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D destination_image;
layout(push_constant) uniform Filter { ivec2 extent; int step_width; int unused; } reconstruction;

float luminance(vec3 value) { return dot(value,vec3(0.2126,0.7152,0.0722)); }

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel,reconstruction.extent))) return;
    uint index = uint(pixel.y*reconstruction.extent.x+pixel.x);
    vec4 input_value = imageLoad(source_image,pixel);
    // Surface pass tags reconstruction eligibility in otherwise unused HDR alpha.
    // Most space pixels avoid reading the larger guide buffer entirely.
    if (input_value.a < 0.5)
    {
        imageStore(destination_image,pixel,input_value);
        return;
    }
    DebugPixel center = debug_pixels[index];
    vec3 value = input_value.rgb;
    // Preserve vacuum, the analytic sun, and mixed subpixel silhouettes exactly.
    // Atmosphere reconstruction is deliberately deferred.
    if ((center.vertex_hit.w != 1.0 && center.vertex_hit.w != 3.0) || center.direct.w != 1.0)
    {
        imageStore(destination_image,pixel,vec4(value,1));
        return;
    }
    vec3 sum = vec3(0);
    float weight_sum = 0.0;
    float center_light = luminance(center.direct.rgb);
    for (int y=-1; y<=1; ++y) for (int x=-1; x<=1; ++x)
    {
        ivec2 position = pixel+ivec2(x,y)*reconstruction.step_width;
        if (any(lessThan(position,ivec2(0))) || any(greaterThanEqual(position,reconstruction.extent))) continue;
        DebugPixel neighbor = debug_pixels[position.y*reconstruction.extent.x+position.x];
        if (neighbor.vertex_hit.w != center.vertex_hit.w || neighbor.direct.w != 1.0) continue;
        float normal_weight = max(0.0,dot(center.normal_depth.xyz,neighbor.normal_depth.xyz));
        normal_weight *= normal_weight; normal_weight *= normal_weight;
        normal_weight *= normal_weight; normal_weight *= normal_weight;
        normal_weight *= normal_weight;
        float depth_delta = abs(center.normal_depth.w-neighbor.normal_depth.w)/max(0.001,center.normal_depth.w);
        vec3 color_delta = center.vertex_hit.rgb-neighbor.vertex_hit.rgb;
        float light_delta = abs(center_light-luminance(neighbor.direct.rgb));
        float light_scale = 0.1+0.5*abs(center_light);
        float weight = normal_weight*max(0.0,1.0-depth_delta*100.0)
            *max(0.0,1.0-dot(color_delta,color_delta)*64.0)
            /(1.0+light_delta*light_delta/(light_scale*light_scale));
        // Nine-tap separable kernel [1,2,1], expanded within this frame.
        weight *= float((x==0 ? 2 : 1)*(y==0 ? 2 : 1));
        vec3 indirect = max(vec3(0),imageLoad(source_image,position).rgb-neighbor.direct.rgb-neighbor.volume.rgb);
        sum += weight*indirect;
        weight_sum += weight;
    }
    imageStore(destination_image,pixel,vec4(center.direct.rgb+center.volume.rgb+sum/max(weight_sum,0.000001),1));
}

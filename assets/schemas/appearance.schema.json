{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanova appearance",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ambient": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 10000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "gradient": {
      "type": "object",
      "properties": {
        "top": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "bottom": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": ["top", "bottom"],
      "additionalProperties": false
    },
    "lights": {
      "type": "object",
      "properties": {
        "key": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 3,
              "maxItems": 3
            },
            "color": {
              "$ref": "shared.schema.json#/$defs/color"
            },
            "irradiance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": ["direction", "color", "irradiance"],
          "additionalProperties": false
        },
        "fill": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 3,
              "maxItems": 3
            },
            "color": {
              "$ref": "shared.schema.json#/$defs/color"
            },
            "irradiance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": ["direction", "color", "irradiance"],
          "additionalProperties": false
        },
        "rim": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 3,
              "maxItems": 3
            },
            "color": {
              "$ref": "shared.schema.json#/$defs/color"
            },
            "irradiance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": ["direction", "color", "irradiance"],
          "additionalProperties": false
        }
      },
      "required": ["key", "fill", "rim"],
      "additionalProperties": false
    },
    "thin_surface": {
      "type": "object",
      "properties": {
        "transmission": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "absorption": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "clarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edge_fade": {
          "type": "object",
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "power": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 16
            }
          },
          "required": ["strength", "power"],
          "additionalProperties": false
        },
        "blur_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        }
      },
      "required": ["transmission", "absorption"],
      "additionalProperties": false
    },
    "backdrop": {
      "type": "object",
      "properties": {
        "model": {
          "$ref": "shared.schema.json#/$defs/path"
        },
        "position": {
          "$ref": "shared.schema.json#/$defs/position"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "tint": {
          "$ref": "shared.schema.json#/$defs/color"
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "soft": {
          "type": "object",
          "properties": {
            "blur_radius": {
              "type": "number",
              "minimum": 1,
              "maximum": 256
            },
            "glow": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "ambient": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "pulse_amplitude": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.15
            },
            "period_seconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 120
            }
          },
          "required": ["blur_radius", "glow", "ambient", "pulse_amplitude", "period_seconds"],
          "additionalProperties": false
        },
        "wave": {
          "type": "object",
          "properties": {
            "amplitude": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1
            },
            "frequency": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "speed": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          },
          "required": ["amplitude", "frequency", "speed"],
          "additionalProperties": false
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "$ref": "shared.schema.json#/$defs/path"
          }
        }
      },
      "required": ["model", "position", "scale", "tint"],
      "additionalProperties": false
    },
    "atmosphere": {
      "type": "object",
      "properties": {
        "center": {
          "$ref": "shared.schema.json#/$defs/position"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "edge_fade": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scattering": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "absorption": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "anisotropy": {
          "type": "number",
          "minimum": -0.95,
          "maximum": 0.95
        },
        "shadows": {
          "type": "boolean"
        }
      },
      "required": ["center", "radius", "edge_fade", "scattering", "absorption", "anisotropy"],
      "additionalProperties": false
    },
    "fog": {
      "type": "object",
      "properties": {
        "blur_radius": {
          "type": "number",
          "minimum": 1,
          "maximum": 256
        },
        "sight_feather": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "plane_z": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "tint": {
          "$ref": "shared.schema.json#/$defs/color"
        },
        "memory_half_life_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        }
      },
      "required": ["blur_radius", "sight_feather", "plane_z"],
      "additionalProperties": false
    },
    "self_glow": {
      "type": "object",
      "description": "Surface emission strengths. These surfaces do not illuminate other objects.",
      "properties": {
        "cell_interior": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "organelles": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "factory_stems": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "factory_leaves": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "units": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        }
      },
      "required": ["cell_interior", "organelles", "factory_stems", "factory_leaves", "units"],
      "additionalProperties": false
    }
  },
  "required": ["ambient"],
  "additionalProperties": false
}

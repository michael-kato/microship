{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanovore appearance",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ambient": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 10000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "gradient": {
      "type": "object",
      "properties": {
        "top": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "bottom": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": ["top", "bottom"],
      "additionalProperties": false
    },
    "lights": {
      "type": "object",
      "properties": {
        "key": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 3,
              "maxItems": 3
            },
            "color": {
              "$ref": "shared.schema.json#/$defs/color"
            },
            "irradiance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": ["direction", "color", "irradiance"],
          "additionalProperties": false
        },
        "fill": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 3,
              "maxItems": 3
            },
            "color": {
              "$ref": "shared.schema.json#/$defs/color"
            },
            "irradiance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": ["direction", "color", "irradiance"],
          "additionalProperties": false
        },
        "rim": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1e+18,
                "maximum": 1e+18
              },
              "minItems": 3,
              "maxItems": 3
            },
            "color": {
              "$ref": "shared.schema.json#/$defs/color"
            },
            "irradiance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": ["direction", "color", "irradiance"],
          "additionalProperties": false
        }
      },
      "required": ["key", "fill", "rim"],
      "additionalProperties": false
    },
    "thin_surface": {
      "type": "object",
      "properties": {
        "transmission": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9,
          "description": "Thin-surface light transmission. Use edge_fade.power to set the rim width."
        },
        "absorption": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "clarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Clear fraction of thin-surface transmission. Zero blocks the clear path. At full edge-fade strength, the angle controls the clear path while this value is positive."
        },
        "edge_fade": {
          "type": "object",
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Angle fade strength. Zero uses transmission times clarity. One keeps the face-on wall clear and blocks clear transmission at the grazing-angle limit."
            },
            "power": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 16,
              "description": "Rim falloff power. Lower values widen the opaque rim; higher values narrow it. Try 0.5 for a wider rim or 2 for a narrow rim."
            }
          },
          "required": ["strength", "power"],
          "additionalProperties": false
        },
        "blur_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "bleed": {
          "type": "object",
          "description": "Interior light a cell wall shows from depth (world units) beneath it, from the cell's radiance cascades; organelle colors appear as soft blobs.",
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": ["strength", "depth"],
          "additionalProperties": false
        }
      },
      "required": ["transmission", "absorption"],
      "additionalProperties": false
    },
    "backdrop": {
      "type": "object",
      "properties": {
        "model": {
          "$ref": "shared.schema.json#/$defs/path"
        },
        "position": {
          "$ref": "shared.schema.json#/$defs/position"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "tint": {
          "$ref": "shared.schema.json#/$defs/color"
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "soft": {
          "type": "object",
          "properties": {
            "blur_radius": {
              "type": "number",
              "minimum": 1,
              "maximum": 256
            },
            "glow": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "ambient": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "pulse_amplitude": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.15
            },
            "period_seconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 120
            }
          },
          "required": ["blur_radius", "glow", "ambient", "pulse_amplitude", "period_seconds"],
          "additionalProperties": false
        },
        "wave": {
          "type": "object",
          "properties": {
            "amplitude": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1
            },
            "frequency": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "speed": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          },
          "required": ["amplitude", "frequency", "speed"],
          "additionalProperties": false
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "$ref": "shared.schema.json#/$defs/path"
          }
        }
      },
      "required": ["model", "position", "scale", "tint"],
      "additionalProperties": false
    },
    "atmosphere": {
      "type": "object",
      "properties": {
        "center": {
          "$ref": "shared.schema.json#/$defs/position"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "edge_fade": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scattering": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "absorption": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "anisotropy": {
          "type": "number",
          "minimum": -0.95,
          "maximum": 0.95
        },
        "shadows": {
          "type": "boolean"
        }
      },
      "required": ["center", "radius", "edge_fade", "scattering", "absorption", "anisotropy"],
      "additionalProperties": false
    },
    "fog": {
      "type": "object",
      "properties": {
        "blur_radius": {
          "type": "number",
          "minimum": 1,
          "maximum": 256
        },
        "sight_feather": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "plane_z": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "tint": {
          "$ref": "shared.schema.json#/$defs/color"
        },
        "memory_half_life_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        }
      },
      "required": ["blur_radius", "sight_feather", "plane_z"],
      "additionalProperties": false
    },
    "self_glow": {
      "type": "object",
      "description": "Surface emission strengths. These surfaces do not illuminate other objects.",
      "properties": {
        "cell_interior": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "organelles": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "factory_stems": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "factory_leaves": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "units": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        }
      },
      "required": ["cell_interior", "organelles", "factory_stems", "factory_leaves", "units"],
      "additionalProperties": false
    },
    "organelle_appearance": {
      "type": "object",
      "properties": {
        "edge_saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "edge_width": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "center_glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "center_power": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        }
      },
      "required": ["edge_saturation", "edge_width", "center_glow", "center_power"],
      "additionalProperties": false
    },
    "cell_medium": {
      "type": "object",
      "properties": {
        "radius_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "edge_fade": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scattering": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "absorption": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "anisotropy": {
          "type": "number",
          "exclusiveMinimum": -0.95,
          "exclusiveMaximum": 0.95
        },
        "depth_blur": {
          "type": "object",
          "properties": {
            "pixels_per_unit": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            },
            "sharp_distance": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "max_radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            },
            "start_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "full_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["max_radius"],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": ["pixels_per_unit", "sharp_distance"],
              "not": {
                "anyOf": [{"required": ["start_fraction"]}, {"required": ["full_fraction"]}]
              }
            },
            {
              "required": ["start_fraction", "full_fraction"],
              "not": {
                "anyOf": [{"required": ["pixels_per_unit"]}, {"required": ["sharp_distance"]}]
              }
            }
          ]
        }
      },
      "required": ["radius_fraction", "edge_fade", "scattering", "absorption", "anisotropy"],
      "additionalProperties": false,
      "description": "Interior medium shared by every cell."
    },
    "electron_microscope": {
      "type": "object",
      "description": "Colorized electron microscope surface look.",
      "properties": {
        "relief": {
          "type": "object",
          "description": "Procedural object-space detail. Frequency: features per object-space unit; depth: slope scale, zero disables a layer. Lumps are two smooth octaves, wrinkles a rounded ridge, fuzz three octaves (each twice the frequency, 0.7 of the slope). Layers fade out between 3 and 1 pixels per feature.",
          "properties": {
            "lumps": {
              "type": "object",
              "properties": {
                "frequency": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "depth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                }
              },
              "required": ["frequency", "depth"],
              "additionalProperties": false
            },
            "wrinkles": {
              "type": "object",
              "properties": {
                "frequency": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "depth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                }
              },
              "required": ["frequency", "depth"],
              "additionalProperties": false
            },
            "fuzz": {
              "type": "object",
              "properties": {
                "frequency": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "depth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                }
              },
              "required": ["frequency", "depth"],
              "additionalProperties": false
            },
            "crease_shadow": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["lumps", "wrinkles", "fuzz", "crease_shadow"],
          "additionalProperties": false
        },
        "edge": {
          "type": "object",
          "description": "Secondary-electron signal on every camera-visible surface: signal * (1 + strength * (1 - n.v)^power), darkened in relief creases. It is not light and never bounces.",
          "properties": {
            "signal": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 16
              },
              "minItems": 3,
              "maxItems": 3
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 64
            },
            "power": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 16
            }
          },
          "required": ["signal", "strength", "power"],
          "additionalProperties": false
        },
        "sheen": {
          "type": "object",
          "description": "Fuzz lobe for studio lights (Charlie sheen); roughness widens it.",
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "roughness": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            }
          },
          "required": ["strength", "roughness"],
          "additionalProperties": false
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Scales every pigment's distance from its luminance; 1 keeps authored colors."
        }
      },
      "required": ["relief", "edge", "sheen", "saturation"],
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "properties": {
        "organelles": {
          "type": "object",
          "properties": {
            "squash": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1
            },
            "period_seconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 300
            }
          },
          "required": ["squash", "period_seconds"],
          "additionalProperties": false
        },
        "membrane": {
          "type": "object",
          "properties": {
            "ripple_strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "wavelength": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 100
            },
            "period_seconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 300
            }
          },
          "required": ["ripple_strength", "wavelength", "period_seconds"],
          "additionalProperties": false
        },
        "factories": {
          "type": "object",
          "properties": {
            "sway_degrees": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "period_seconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 300
            }
          },
          "required": ["sway_degrees", "period_seconds"],
          "additionalProperties": false
        }
      },
      "required": ["organelles", "membrane", "factories"],
      "additionalProperties": false
    },
    "factory_appearance": {
      "type": "object",
      "properties": {
        "emission_fresnel": {
          "type": "object",
          "description": "Reduce factory emission at grazing view angles. Larger power narrows the dark rim.",
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "power": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 16
            }
          },
          "required": ["strength", "power"],
          "additionalProperties": false
        },
        "emission_color": {
          "type": "array",
          "description": "Factory emission RGB in linear color. Does not change surface pigment. Omit to use the surface color.",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": ["emission_fresnel"],
      "additionalProperties": false
    },
    "communications": {
      "$ref": "shared.schema.json#/$defs/path"
    }
  },
  "required": ["ambient"],
  "additionalProperties": false
}

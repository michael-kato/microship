{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanova buildings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "faction": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "model": {
            "$ref": "shared.schema.json#/$defs/path"
          },
          "growth_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "health": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "collection": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "hits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "branches": {
            "type": "object",
            "properties": {
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "spacing": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "production": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777215
              },
              "normal": {
                "$ref": "shared.schema.json#/$defs/normal"
              },
              "health": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "hits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "regrow_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              },
              "roots": {
                "type": "string",
                "enum": [
                  "single",
                  "organelles"
                ]
              },
              "grammar": {
                "type": "string",
                "enum": [
                  "axial",
                  "fan",
                  "hypha",
                  "tree"
                ]
              },
              "tree": {
                "type": "object",
                "properties": {
                  "children": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 3
                  },
                  "levels": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 5
                  },
                  "length_scale": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 0.9
                  },
                  "width_scale": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 0.9
                  },
                  "angle_degrees": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 65
                  },
                  "bend": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 0.5
                  },
                  "root_share": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 0.9
                  }
                },
                "required": [
                  "children",
                  "levels",
                  "length_scale",
                  "width_scale",
                  "angle_degrees",
                  "bend",
                  "root_share"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "seconds",
              "count",
              "spacing",
              "production",
              "seed",
              "normal"
            ],
            "additionalProperties": false
          },
          "growth_meshes": {
            "type": "object",
            "properties": {
              "segment": {
                "$ref": "shared.schema.json#/$defs/path"
              },
              "tip": {
                "$ref": "shared.schema.json#/$defs/path"
              }
            },
            "required": [
              "segment",
              "tip"
            ],
            "additionalProperties": false
          },
          "navigation": {
            "type": "object",
            "properties": {
              "stem_radius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "head_radius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              }
            },
            "required": [
              "stem_radius",
              "head_radius"
            ],
            "additionalProperties": false
          },
          "establishment_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "growth_plane": {
            "type": "object",
            "properties": {
              "normal": {
                "$ref": "shared.schema.json#/$defs/normal"
              },
              "depth_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "normal",
              "depth_ratio"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "faction",
          "model",
          "growth_seconds",
          "health",
          "collection",
          "height",
          "width",
          "hits",
          "branches"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    }
  },
  "required": [
    "buildings"
  ],
  "additionalProperties": false
}

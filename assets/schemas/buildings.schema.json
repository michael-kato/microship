{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanova buildings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "faction": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "model": {
            "$ref": "shared.schema.json#/$defs/path"
          },
          "health": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "hits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "branches": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "spacing": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "production": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "health": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "hits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "grammar": {
                "type": "string",
                "enum": ["axial", "fan", "hypha", "tree"]
              },
              "tree": {
                "type": "object",
                "properties": {
                  "children": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 3
                  },
                  "levels": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 5
                  },
                  "length_scale": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 0.9
                  },
                  "width_scale": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 0.9
                  },
                  "angle_degrees": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 65
                  },
                  "bend": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 0.5
                  },
                  "branch_probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "angle_jitter_degrees": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30
                  },
                  "length_jitter": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.4
                  },
                  "width_jitter": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.3
                  }
                },
                "required": [
                  "children",
                  "levels",
                  "length_scale",
                  "width_scale",
                  "angle_degrees",
                  "bend"
                ],
                "additionalProperties": false
              },
              "root_interval_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": ["count", "spacing", "production"],
            "additionalProperties": false
          },
          "growth_meshes": {
            "type": "object",
            "properties": {
              "segment": {
                "$ref": "shared.schema.json#/$defs/path"
              },
              "tip": {
                "$ref": "shared.schema.json#/$defs/path"
              }
            },
            "required": ["segment", "tip"],
            "additionalProperties": false
          },
          "navigation": {
            "type": "object",
            "properties": {
              "stem_radius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "head_radius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              }
            },
            "required": ["stem_radius", "head_radius"],
            "additionalProperties": false
          },
          "haze": {
            "type": "object",
            "properties": {
              "reach": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 20
              },
              "damage_per_second": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "heal_per_second": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              }
            },
            "required": ["reach", "damage_per_second", "heal_per_second"],
            "additionalProperties": false
          }
        },
        "required": ["name", "faction", "model", "health", "hits", "branches"],
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "shared": {
      "type": "object",
      "properties": {
        "growth_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "sprout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "establishment_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "collection": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "repair": {
          "type": "object",
          "properties": {
            "health_per_second": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "nutrients_per_health": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "delay_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": ["health_per_second", "nutrients_per_health", "delay_seconds"],
          "additionalProperties": false
        },
        "growth_plane": {
          "type": "object",
          "properties": {
            "normal": {
              "$ref": "shared.schema.json#/$defs/normal"
            },
            "depth_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "spread_roots": {
              "type": "boolean"
            }
          },
          "required": ["normal", "depth_ratio"],
          "additionalProperties": false
        },
        "branches": {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 300
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            },
            "regrow_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 300
            },
            "roots": {
              "type": "string",
              "enum": ["single", "organelles"]
            },
            "root_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "root_minimum_radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5
            },
            "root_offset_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": ["seconds", "seed"],
          "additionalProperties": false
        }
      },
      "required": ["growth_seconds", "collection", "height", "width", "branches", "growth_plane"],
      "additionalProperties": false
    }
  },
  "required": ["buildings", "shared"],
  "additionalProperties": false
}

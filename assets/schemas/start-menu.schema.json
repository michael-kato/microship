{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 79
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 159
    },
    "width": {
      "type": "integer",
      "minimum": 1920,
      "maximum": 3840
    },
    "height": {
      "type": "integer",
      "minimum": 1080,
      "maximum": 2160
    },
    "background": {
      "$ref": "shared.schema.json#/$defs/color"
    },
    "text": {
      "$ref": "shared.schema.json#/$defs/color"
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 159
          },
          "world": {
            "$ref": "shared.schema.json#/$defs/path"
          },
          "color": {
            "$ref": "shared.schema.json#/$defs/color"
          }
        },
        "required": [
          "label",
          "description",
          "world",
          "color"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "prompt",
    "width",
    "height",
    "background",
    "text",
    "choices"
  ],
  "additionalProperties": false
}

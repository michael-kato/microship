{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanova effects",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "projectile": {
      "type": "object",
      "properties": {
        "projectile_speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "shot_interval": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "trail_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "trail_lifetime": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "flash_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2
        },
        "pop_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2
        },
        "pop_radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "trail_length_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "projectile_speed",
        "shot_interval",
        "trail_width",
        "trail_lifetime",
        "flash_seconds",
        "pop_seconds",
        "pop_radius"
      ],
      "additionalProperties": false
    },
    "damage": {
      "type": "object",
      "properties": {
        "flash": {
          "$ref": "shared.schema.json#/$defs/color"
        },
        "injured": {
          "$ref": "shared.schema.json#/$defs/color"
        }
      },
      "required": ["flash", "injured"],
      "additionalProperties": false
    },
    "injury": {
      "type": "object",
      "properties": {
        "first": {
          "$ref": "shared.schema.json#/$defs/color"
        },
        "later": {
          "$ref": "shared.schema.json#/$defs/color"
        }
      },
      "required": ["first", "later"],
      "additionalProperties": false
    },
    "spikes": {
      "type": "object",
      "properties": {
        "model": {
          "$ref": "shared.schema.json#/$defs/path"
        },
        "root_radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2
        },
        "projectile_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": ["model", "root_radius", "length", "projectile_scale"],
      "additionalProperties": false
    },
    "limb_break": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "drag": {
          "type": "number",
          "maximum": 10,
          "minimum": 0
        },
        "spin": {
          "type": "number",
          "maximum": 20,
          "minimum": 0
        },
        "shrink_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      },
      "required": ["seconds", "speed", "drag", "spin", "shrink_seconds"],
      "additionalProperties": false
    },
    "target_line": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hold_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "fade_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        }
      },
      "required": ["width", "alpha"],
      "additionalProperties": false
    },
    "spore_cloud": {
      "type": "object",
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["color", "alpha"],
      "additionalProperties": false
    },
    "heal_aura": {
      "type": "object",
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["color", "alpha"],
      "additionalProperties": false
    },
    "cell_haze": {
      "type": "object",
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fade_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      },
      "required": ["color", "alpha"],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanova factions",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "factions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "name": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "label": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "color": {
            "$ref": "shared.schema.json#/$defs/color"
          },
          "production": {
            "type": "object",
            "properties": {
              "building": {
                "$ref": "shared.schema.json#/$defs/name"
              },
              "default_unit": {
                "$ref": "shared.schema.json#/$defs/name"
              },
              "assault_unit": {
                "$ref": "shared.schema.json#/$defs/name"
              },
              "mode": {
                "enum": [
                  "manufacture",
                  "spores"
                ]
              }
            },
            "required": [
              "building",
              "default_unit",
              "assault_unit"
            ],
            "additionalProperties": false
          },
          "cell_appearance": {
            "type": "object",
            "properties": {
              "tint": {
                "$ref": "shared.schema.json#/$defs/color"
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3600
              },
              "roughness": {
                "type": "number",
                "minimum": 0.02,
                "maximum": 1
              },
              "displacement": {
                "type": "object",
                "properties": {
                  "features": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 0.2
                  },
                  "width_degrees": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 75
                  },
                  "profile": {
                    "enum": [
                      "pointed",
                      "rounded"
                    ]
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16777215
                  }
                },
                "required": [
                  "features",
                  "height",
                  "width_degrees",
                  "profile",
                  "seed"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "tint",
              "strength",
              "seconds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "label",
          "color"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    }
  },
  "required": [
    "factions"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanova render",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "exposure": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "width",
        "height",
        "exposure"
      ],
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "properties": {
        "samples_per_pixel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "max_transmission_layers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "spatial_antialiasing": {
          "type": "boolean"
        }
      },
      "required": [
        "samples_per_pixel",
        "seed",
        "max_transmission_layers"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "sphere_segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 512
        },
        "sphere_rings": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        }
      },
      "required": [
        "sphere_segments",
        "sphere_rings"
      ],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "shared.schema.json#/$defs/position"
        },
        "target": {
          "$ref": "shared.schema.json#/$defs/position"
        },
        "up": {
          "$ref": "shared.schema.json#/$defs/position"
        },
        "min_distance": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000000
        },
        "max_distance": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000000
        },
        "vertical_fov_degrees": {
          "type": "number",
          "exclusiveMinimum": 1,
          "exclusiveMaximum": 179
        },
        "keyboard_pan_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "position",
        "target",
        "up",
        "min_distance",
        "max_distance",
        "vertical_fov_degrees"
      ],
      "additionalProperties": false
    },
    "lighting": {
      "type": "object",
      "properties": {
        "microfacet_energy_compensation": {
          "type": "boolean"
        },
        "shadow_grid_resolution": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 8,
              "maximum": 64
            }
          ]
        },
        "static_lighting_cache": {
          "type": "boolean"
        },
        "force_lighting_rebuild": {
          "type": "boolean"
        },
        "texture_grid": {
          "type": "boolean"
        },
        "organelle_cache": {
          "type": "boolean"
        },
        "subgroup_size": {
          "type": "integer",
          "enum": [
            0,
            32,
            64
          ]
        }
      },
      "required": [
        "microfacet_energy_compensation"
      ],
      "additionalProperties": false
    },
    "bloom": {
      "type": "object",
      "properties": {
        "radius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "radius",
        "strength",
        "threshold"
      ],
      "additionalProperties": false
    },
    "volume": {
      "type": "object",
      "properties": {
        "rays_per_pixel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "integration_steps": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "optical_depth_lut": {
          "type": "boolean"
        },
        "lighting_grid": {
          "type": "boolean"
        },
        "quadrature": {
          "enum": [
            "midpoint",
            "gauss_legendre"
          ]
        },
        "spatial_filter": {
          "type": "boolean"
        },
        "spatial_stride": {
          "enum": [
            2,
            4
          ]
        }
      },
      "required": [
        "rays_per_pixel",
        "integration_steps"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "quadrature"
            ],
            "properties": {
              "quadrature": {
                "const": "gauss_legendre"
              }
            }
          },
          "then": {
            "properties": {
              "integration_steps": {
                "enum": [
                  2,
                  3
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "spatial_filter"
            ],
            "properties": {
              "spatial_filter": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "rays_per_pixel": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "tilt_shift": {
      "type": "object",
      "properties": {
        "focus_center": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "focus_half_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "falloff": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        }
      },
      "required": [
        "focus_center",
        "focus_half_width",
        "falloff",
        "max_radius"
      ],
      "additionalProperties": false
    },
    "subsurface": {
      "type": "object",
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wrap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transmission": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "membrane_thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "samples_per_pixel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "required": [
        "strength",
        "wrap",
        "transmission",
        "membrane_thickness",
        "samples_per_pixel"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "output",
    "sampling",
    "geometry",
    "camera",
    "lighting",
    "bloom",
    "volume"
  ],
  "additionalProperties": false
}

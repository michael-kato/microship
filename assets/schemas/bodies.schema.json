{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanova bodies",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "label": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "geometry": {
            "enum": ["mesh", "sphere"]
          },
          "model": {
            "$ref": "shared.schema.json#/$defs/path"
          },
          "hosts_site": {
            "type": "boolean"
          },
          "variation": {
            "type": "object",
            "properties": {
              "parts": {
                "$ref": "shared.schema.json#/$defs/path"
              },
              "shape": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.12
              },
              "interior": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.15
              },
              "wall_noise": {
                "type": "object",
                "properties": {
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "frequency": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 32
                  },
                  "warm": {
                    "$ref": "shared.schema.json#/$defs/color"
                  },
                  "cool": {
                    "$ref": "shared.schema.json#/$defs/color"
                  }
                },
                "required": ["strength", "frequency", "warm", "cool"],
                "additionalProperties": false
              },
              "layout_rotation_degrees": {
                "type": "number",
                "minimum": 0,
                "maximum": 180
              }
            },
            "required": ["parts", "shape", "interior"],
            "additionalProperties": false
          }
        },
        "required": ["name", "label", "geometry", "hosts_site"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "geometry": {
                  "const": "mesh"
                }
              }
            },
            "then": {
              "required": ["model"]
            },
            "else": {
              "not": {
                "required": ["model"]
              }
            }
          }
        ]
      },
      "maxItems": 32
    }
  },
  "required": ["bodies"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanovore world",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "content": {
      "$ref": "shared.schema.json#/$defs/path",
      "description": "Test override only; the game uses the global file named in startup.json."
    },
    "rules": {
      "$ref": "shared.schema.json#/$defs/path",
      "description": "Test override only; the game uses the global file named in startup.json."
    },
    "appearance": {
      "$ref": "shared.schema.json#/$defs/path",
      "description": "Test override only; the game uses the global file named in startup.json."
    },
    "effects": {
      "$ref": "shared.schema.json#/$defs/path",
      "description": "Test override only; the game uses the global file named in startup.json."
    },
    "match": {
      "type": "object",
      "properties": {
        "player": {
          "$ref": "shared.schema.json#/$defs/name"
        },
        "opponent": {
          "$ref": "shared.schema.json#/$defs/name"
        },
        "starts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "faction": {
                "$ref": "shared.schema.json#/$defs/name"
              },
              "cell": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "forces": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "$ref": "shared.schema.json#/$defs/name"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    }
                  },
                  "required": ["type", "count"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["faction"],
            "additionalProperties": false
          }
        },
        "force_ring": {
          "type": "object",
          "properties": {
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "height": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "required": ["radius", "height"],
          "additionalProperties": false
        },
        "auto_colonize": {
          "type": "boolean"
        },
        "player_ai": {
          "type": "boolean"
        },
        "fully_established": {
          "type": "boolean"
        },
        "rally_point": {
          "$ref": "shared.schema.json#/$defs/position"
        },
        "rally_factions": {
          "description": "Factions sent to the rally point; the others hold and orbit their cells. Default: every faction.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "production_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "formation_spacing": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "colonized_starts": {
          "type": "boolean"
        }
      },
      "required": ["player"],
      "additionalProperties": false,
      "anyOf": [{"required": ["opponent"]}, {"required": ["starts"]}]
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "owner": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "position": {
            "$ref": "shared.schema.json#/$defs/position"
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "site": {
            "type": "object",
            "properties": {
              "normal": {
                "$ref": "shared.schema.json#/$defs/normal"
              },
              "availability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["normal", "availability"],
            "additionalProperties": false
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777215
          },
          "tint": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Test override only: vertex color multiplier, white by default."
          }
        },
        "required": ["type", "owner", "position", "radius"],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "layout": {
      "type": "object",
      "properties": {
        "field_radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "first_home_degrees": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "minimum_gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "centroid_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "home": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "cell": {
              "$ref": "#/$defs/cell_template"
            }
          },
          "required": ["count", "cell"],
          "additionalProperties": false
        },
        "center": {
          "type": "object",
          "properties": {
            "jitter": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            },
            "cell": {
              "$ref": "#/$defs/cell_template"
            }
          },
          "required": ["jitter", "cell"],
          "additionalProperties": false
        },
        "neutral": {
          "type": "object",
          "properties": {
            "radius_range": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2
            },
            "cell": {
              "$ref": "#/$defs/neutral_template"
            }
          },
          "required": ["radius_range", "cell"],
          "additionalProperties": false
        }
      },
      "required": ["field_radius", "cells", "minimum_gap", "centroid_steps", "home", "neutral"],
      "additionalProperties": false
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "position": {
            "$ref": "shared.schema.json#/$defs/position"
          },
          "cell": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "offset": {
            "$ref": "shared.schema.json#/$defs/position"
          }
        },
        "additionalProperties": false,
        "required": ["type"],
        "oneOf": [
          {
            "required": ["position"],
            "not": {
              "anyOf": [{"required": ["cell"]}, {"required": ["offset"]}]
            }
          },
          {
            "required": ["cell", "offset"],
            "not": {
              "required": ["position"]
            }
          }
        ]
      },
      "maxItems": 64
    }
  },
  "required": ["match"],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "bodies": {
          "minItems": 1
        }
      },
      "required": ["bodies"]
    },
    {
      "required": ["layout"]
    },
    {
      "properties": {
        "spawns": {
          "minItems": 1
        }
      }
    }
  ],
  "oneOf": [
    {
      "required": ["bodies"],
      "not": {
        "required": ["layout"]
      }
    },
    {
      "required": ["layout"],
      "not": {
        "required": ["bodies"]
      }
    }
  ],
  "$defs": {
    "cell_template": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "shared.schema.json#/$defs/name"
        },
        "owner": {
          "$ref": "shared.schema.json#/$defs/name"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "site": {
          "type": "object",
          "properties": {
            "normal": {
              "$ref": "shared.schema.json#/$defs/normal"
            },
            "availability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["normal", "availability"],
          "additionalProperties": false
        },
        "tint": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Test override only: vertex color multiplier, white by default."
        }
      },
      "required": ["type", "owner", "radius"],
      "additionalProperties": false
    },
    "neutral_template": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "shared.schema.json#/$defs/name"
        },
        "owner": {
          "$ref": "shared.schema.json#/$defs/name"
        },
        "site": {
          "type": "object",
          "properties": {
            "normal": {
              "$ref": "shared.schema.json#/$defs/normal"
            },
            "availability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["normal", "availability"],
          "additionalProperties": false
        },
        "tint": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Test override only: vertex color multiplier, white by default."
        }
      },
      "required": ["type", "owner"],
      "additionalProperties": false
    }
  }
}

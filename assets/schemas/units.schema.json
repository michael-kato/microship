{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanova units",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "faction": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "group": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "model": {
            "$ref": "shared.schema.json#/$defs/path"
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "yaw_degrees": {
            "type": "number",
            "minimum": -360000,
            "maximum": 360000
          },
          "tint": {
            "$ref": "shared.schema.json#/$defs/color"
          },
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "health": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "range": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "cost": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "shot_interval": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "separation": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "targets": {
            "type": "array",
            "items": {
              "enum": ["units", "structures"]
            },
            "maxItems": 2,
            "uniqueItems": true
          },
          "colonizes": {
            "type": "boolean"
          },
          "detaches": {
            "type": "boolean"
          },
          "trails": {
            "type": "boolean"
          },
          "pick_radius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "cue_radius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "hits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "attack": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": ["projectile", "digest", "spore"]
              },
              "seek_radius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "blast_radius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "lifetime": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              },
              "friendly_fire": {
                "type": "boolean"
              },
              "charge_radius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "charge_speed": {
                "type": "number",
                "minimum": 1,
                "maximum": 8
              },
              "charge_acceleration": {
                "type": "number",
                "minimum": 1,
                "maximum": 8
              },
              "release_hits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "release_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              }
            },
            "required": ["mode"],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "spore"
                    }
                  }
                },
                "then": {
                  "required": ["seek_radius", "blast_radius", "lifetime", "friendly_fire"]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": ["seek_radius"]
                      },
                      {
                        "required": ["blast_radius"]
                      },
                      {
                        "required": ["lifetime"]
                      },
                      {
                        "required": ["friendly_fire"]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "digest"
                    }
                  }
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": ["charge_radius"]
                      },
                      {
                        "required": ["charge_speed"]
                      },
                      {
                        "required": ["charge_acceleration"]
                      },
                      {
                        "required": ["release_hits"]
                      },
                      {
                        "required": ["release_seconds"]
                      }
                    ]
                  }
                }
              }
            ],
            "dependentRequired": {
              "release_hits": ["release_seconds"],
              "release_seconds": ["release_hits"]
            }
          },
          "secondary_attack": {
            "type": "object",
            "properties": {
              "targets": {
                "type": "array",
                "items": {
                  "enum": ["units", "structures"]
                },
                "maxItems": 2,
                "uniqueItems": true
              },
              "interval_factor": {
                "type": "number",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": ["targets", "interval_factor"],
            "additionalProperties": false
          },
          "autonomy": {
            "type": "object",
            "properties": {
              "unit_radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "structure_radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "colonize_radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "leash_radius": {
                "type": "number",
                "maximum": 100,
                "exclusiveMinimum": 0
              },
              "response_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "cruise_fraction": {
                "type": "number",
                "maximum": 1,
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "unit_radius",
              "structure_radius",
              "colonize_radius",
              "leash_radius",
              "response_seconds",
              "cruise_fraction"
            ],
            "additionalProperties": false
          },
          "payload": {
            "type": "object",
            "properties": {
              "model": {
                "$ref": "shared.schema.json#/$defs/path"
              },
              "reload_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3600
              },
              "sockets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -10,
                    "maximum": 10
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            },
            "required": ["model", "reload_seconds", "sockets"],
            "additionalProperties": false
          },
          "trail_origin": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10,
              "maximum": 10
            }
          },
          "rear_tint": {
            "type": "object",
            "properties": {
              "color": {
                "$ref": "shared.schema.json#/$defs/color"
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["color", "strength"],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "faction",
          "group",
          "model",
          "scale",
          "yaw_degrees",
          "tint",
          "speed",
          "health",
          "range",
          "cost",
          "shot_interval",
          "separation",
          "targets",
          "colonizes",
          "detaches",
          "trails",
          "pick_radius",
          "cue_radius",
          "hits"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    }
  },
  "required": ["units"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "shape": {
            "enum": ["leaf"]
          },
          "color": {
            "$ref": "shared.schema.json#/$defs/color"
          },
          "roughness": {
            "type": "number",
            "minimum": 0.02,
            "maximum": 1
          },
          "ior": {
            "type": "number",
            "minimum": 1,
            "maximum": 3
          },
          "subsurface": {
            "type": "object",
            "properties": {
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "radius": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0.0001,
                  "maximum": 10
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": ["weight", "radius"],
            "additionalProperties": false
          }
        },
        "required": ["name", "shape", "color", "roughness", "ior", "subsurface"],
        "additionalProperties": false
      }
    }
  },
  "required": ["forms"],
  "additionalProperties": false
}

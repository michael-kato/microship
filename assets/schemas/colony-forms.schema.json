{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "shape": {
            "enum": [
              "leaf",
              "spine",
              "lobe"
            ]
          },
          "color": {
            "$ref": "shared.schema.json#/$defs/color"
          },
          "roughness": {
            "type": "number",
            "minimum": 0.02,
            "maximum": 1
          },
          "ior": {
            "type": "number",
            "minimum": 1,
            "maximum": 3
          }
        },
        "required": [
          "name",
          "shape",
          "color",
          "roughness",
          "ior"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "forms"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sound event bank",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "distance": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "events": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/$defs/clip"
        },
        "growth": {
          "$ref": "#/$defs/clip"
        },
        "mature": {
          "$ref": "#/$defs/clip"
        },
        "birth": {
          "$ref": "#/$defs/clip"
        },
        "shot": {
          "$ref": "#/$defs/clip"
        },
        "hit": {
          "$ref": "#/$defs/clip"
        },
        "death": {
          "$ref": "#/$defs/clip"
        },
        "colonize": {
          "$ref": "#/$defs/clip"
        },
        "heal": {
          "$ref": "#/$defs/clip"
        },
        "win": {
          "$ref": "#/$defs/clip"
        },
        "lose": {
          "$ref": "#/$defs/clip"
        },
        "break": {
          "$ref": "#/$defs/clip"
        },
        "alert": {
          "$ref": "#/$defs/clip"
        },
        "transmission": {
          "$ref": "#/$defs/clip"
        }
      },
      "required": [
        "order",
        "growth",
        "mature",
        "birth",
        "shot",
        "hit",
        "death",
        "colonize",
        "heal",
        "win",
        "lose",
        "break",
        "alert",
        "transmission"
      ],
      "additionalProperties": false
    },
    "banks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "shared.schema.json#/$defs/name"
          },
          "events": {
            "type": "object",
            "properties": {
              "order": {
                "$ref": "#/$defs/clip"
              },
              "growth": {
                "$ref": "#/$defs/clip"
              },
              "mature": {
                "$ref": "#/$defs/clip"
              },
              "birth": {
                "$ref": "#/$defs/clip"
              },
              "shot": {
                "$ref": "#/$defs/clip"
              },
              "hit": {
                "$ref": "#/$defs/clip"
              },
              "death": {
                "$ref": "#/$defs/clip"
              },
              "colonize": {
                "$ref": "#/$defs/clip"
              },
              "heal": {
                "$ref": "#/$defs/clip"
              },
              "win": {
                "$ref": "#/$defs/clip"
              },
              "lose": {
                "$ref": "#/$defs/clip"
              },
              "break": {
                "$ref": "#/$defs/clip"
              },
              "alert": {
                "$ref": "#/$defs/clip"
              },
              "transmission": {
                "$ref": "#/$defs/clip"
              }
            },
            "minProperties": 1,
            "additionalProperties": false
          }
        },
        "required": ["name", "events"],
        "additionalProperties": false
      }
    }
  },
  "required": ["distance", "events"],
  "additionalProperties": false,
  "$defs": {
    "clip": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "shared.schema.json#/$defs/path"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": ["file", "gain", "cooldown"],
      "additionalProperties": false
    }
  }
}
